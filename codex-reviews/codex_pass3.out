  1134	    def format_message(self, content: str) -> str:
  1135	        """Convert standard markdown to Slack mrkdwn format.
  1136	
  1137	        Protected regions (code blocks, inline code) are extracted first so
  1138	        their contents are never modified.  Standard markdown constructs
  1139	        (headers, bold, italic, links) are translated to mrkdwn syntax.
  1140	        """
