 11193	        if enriched_parts:
 11194	            prefix = "\n\n".join(enriched_parts)
 11195	            # Strip the empty-content placeholder from the Discord adapter
 11196	            # when we successfully transcribed the audio — it's redundant.
 11197	            _placeholder = "(The user sent a message with no text content)"
 11198	            if user_text and user_text.strip() == _placeholder:
 11199	                return prefix
 11200	            if user_text:
 11201	                return f"{prefix}\n\n{user_text}"
 11202	            return prefix
 11203	        return user_text
