  2703	    async def _drain_active_agents(self, timeout: float) -> tuple[Dict[str, Any], bool]:
  2704	        snapshot = self._snapshot_running_agents()
  2705	        last_active_count = self._running_agent_count()
  2706	        last_status_at = 0.0
  2707	
  2708	        def _maybe_update_status(force: bool = False) -> None:
  2709	            nonlocal last_active_count, last_status_at
  2710	            now = asyncio.get_running_loop().time()
  2711	            active_count = self._running_agent_count()
  2712	            if force or active_count != last_active_count or (now - last_status_at) >= 1.0:
  2713	                self._update_runtime_status("draining")
  2714	                last_active_count = active_count
  2715	                last_status_at = now
  2716	
  2717	        if not self._running_agents:
  2718	            _maybe_update_status(force=True)
  2719	            return snapshot, False
