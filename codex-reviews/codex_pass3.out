   594	def build_session_key(
   595	    source: SessionSource,
   596	    group_sessions_per_user: bool = True,
   597	    thread_sessions_per_user: bool = False,
   598	) -> str:
   599	    """Build a deterministic session key from a message source.
   600	
   601	    This is the single source of truth for session key construction.
   602	
   603	    DM rules:
   604	      - DMs include chat_id when present, so each private conversation is isolated.
   605	      - thread_id further differentiates threaded DMs within the same DM chat.
   606	      - Without chat_id, thread_id is used as a best-effort fallback.
   607	      - Without thread_id or chat_id, DMs share a single session.
   608	
   609	    Group/channel rules:
   610	      - chat_id identifies the parent group/channel.
   611	      - user_id/user_id_alt isolates participants within that parent chat when available when
   612	        ``group_sessions_per_user`` is enabled.
   613	      - thread_id differentiates threads within that parent chat.  When
   614	        ``thread_sessions_per_user`` is False (default), threads are *shared* across all
   615	        participants — user_id is NOT appended, so every user in the thread
   616	        shares a single session.  This is the expected UX for threaded
   617	        conversations (Telegram forum topics, Discord threads, Slack threads).
   618	      - Without participant identifiers, or when isolation is disabled, messages fall back to one
   619	        shared session per chat.
   620	      - Without identifiers, messages fall back to one session per platform/chat_type.
   621	    """
   622	    platform = source.platform.value
   623	    if source.chat_type == "dm":
   624	        dm_chat_id = source.chat_id
   625	        if source.platform == Platform.WHATSAPP:
   626	            dm_chat_id = canonical_whatsapp_identifier(source.chat_id)
   627	
   628	        if dm_chat_id:
   629	            if source.thread_id:
   630	                return f"agent:main:{platform}:dm:{dm_chat_id}:{source.thread_id}"
   631	            return f"agent:main:{platform}:dm:{dm_chat_id}"
   632	        if source.thread_id:
   633	            return f"agent:main:{platform}:dm:{source.thread_id}"
   634	        return f"agent:main:{platform}:dm"
   635	
   636	    participant_id = source.user_id_alt or source.user_id
   637	    if participant_id and source.platform == Platform.WHATSAPP:
   638	        # Same JID/LID-flip bug as the DM case: without canonicalisation, a
   639	        # single group member gets two isolated per-user sessions when the
   640	        # bridge reshuffles alias forms.
   641	        participant_id = canonical_whatsapp_identifier(str(participant_id)) or participant_id
   642	    key_parts = ["agent:main", platform, source.chat_type]
   643	
   644	    if source.chat_id:
   645	        key_parts.append(source.chat_id)
   646	    if source.thread_id:
   647	        key_parts.append(source.thread_id)
   648	
   649	    # In threads, default to shared sessions (all participants see the same
   650	    # conversation).  Per-user isolation only applies when explicitly enabled
   651	    # via thread_sessions_per_user, or when there is no thread (regular group).
   652	    isolate_user = group_sessions_per_user
   653	    if source.thread_id and not thread_sessions_per_user:
   654	        isolate_user = False
   655	
   656	    if isolate_user and participant_id:
   657	        key_parts.append(str(participant_id))
   658	
   659	    return ":".join(key_parts)
