  2640	            return "⏩ Steered into the current run."
  2641	        if primitive == PRIMITIVE_INTERRUPT:
  2642	            return "⚡ Interrupted — your message starts the next turn."
  2643	        if primitive == PRIMITIVE_STOP:
  2644	            return "🛑 Stopped."
