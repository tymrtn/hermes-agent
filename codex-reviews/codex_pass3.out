  1152	            return key
  1153	
  1154	        text = content
  1155	
  1156	        # 1) Protect fenced code blocks (``` ... ```)
  1157	        text = re.sub(
  1158	            r'(```(?:[^\n]*\n)?[\s\S]*?```)',
  1159	            lambda m: _ph(m.group(0)),
  1160	            text,
  1161	        )
  1162	
  1163	        # 2) Protect inline code (`...`)
  1164	        text = re.sub(r'(`[^`]+`)', lambda m: _ph(m.group(0)), text)
  1165	
  1166	        # 3) Convert markdown links [text](url) → <url|text>
  1167	        def _convert_markdown_link(m):
  1168	            label = m.group(1)
  1169	            url = m.group(2).strip()
  1170	            if url.startswith('<') and url.endswith('>'):
  1171	                url = url[1:-1].strip()
  1172	            return _ph(f'<{url}|{label}>')
  1173	
  1174	        text = re.sub(
  1175	            r'(?<!!)\[([^\]]+)\]\(([^()]*(?:\([^()]*\)[^()]*)*)\)',
  1176	            _convert_markdown_link,
  1177	            text,
  1178	        )
