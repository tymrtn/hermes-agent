  4102	def _component_check_auth(
  4103	    interaction,
  4104	    allowed_user_ids: Optional[set],
  4105	    allowed_role_ids: Optional[set],
  4106	) -> bool:
  4107	    """Shared user-or-role OR semantics for component view button clicks.
  4108	
  4109	    Mirrors ``DiscordAdapter._is_allowed_user`` / the slash and on_message
  4110	    gates so every Discord interaction surface honors the same trust
  4111	    boundary. Component views (ExecApprovalView, SlashConfirmView,
  4112	    UpdatePromptView, ModelPickerView) used to receive only
  4113	    ``allowed_user_ids``: in role-only deployments
  4114	    (DISCORD_ALLOWED_ROLES set, DISCORD_ALLOWED_USERS empty) the user
  4115	    set was empty and the legacy "no allowlist = allow everyone" branch
  4116	    let any guild member click the buttons -- approving exec commands,
  4117	    cancelling slash confirmations, switching the model.
  4118	
  4119	    Behavior:
  4120	
  4121	      - both allowlists empty -> allow (preserves existing no-allowlist
  4122	        deployments, no regression)
  4123	      - user is in user allowlist -> allow
  4124	      - role allowlist set + user has a role in it -> allow
  4125	      - role allowlist set + interaction.user has no resolvable
  4126	        ``roles`` attribute (e.g. DM context with a role policy active)
  4127	        -> reject (fail closed)
  4128	      - otherwise -> reject
  4129	    """
  4130	    user_set = allowed_user_ids or set()
  4131	    role_set = allowed_role_ids or set()
  4132	    has_users = bool(user_set)
  4133	    has_roles = bool(role_set)
  4134	    if not has_users and not has_roles:
  4135	        return True
  4136	
  4137	    user = getattr(interaction, "user", None)
  4138	    if user is None:
  4139	        return False
  4140	
  4141	    if has_users:
  4142	        try:
  4143	            uid = str(user.id)
  4144	        except AttributeError:
  4145	            uid = ""

