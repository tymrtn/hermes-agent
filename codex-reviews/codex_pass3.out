 11205	    def _build_process_event_source(self, evt: dict):
 11206	        """Resolve the canonical source for a synthetic background-process event.
 11207	
 11208	        Prefer the persisted session-store origin for the event's session key.
 11209	        Falling back to the currently active foreground event is what causes
 11210	        cross-topic bleed, so don't do that.
 11211	        """
 11212	        from gateway.session import SessionSource
 11213	
 11214	        session_key = str(evt.get("session_key") or "").strip()
 11215	        derived_platform = ""
 11216	        derived_chat_type = ""
 11217	        derived_chat_id = ""
 11218	
 11219	        if session_key:
 11220	            try:
 11221	                self.session_store._ensure_loaded()
 11222	                entry = self.session_store._entries.get(session_key)
 11223	                if entry and getattr(entry, "origin", None):
 11224	                    return entry.origin
 11225	            except Exception as exc:
 11226	                logger.debug(
 11227	                    "Synthetic process-event session-store lookup failed for %s: %s",
 11228	                    session_key,
 11229	                    exc,
 11230	                )
 11231	
 11232	            _parsed = _parse_session_key(session_key)
 11233	            if _parsed:
 11234	                derived_platform = _parsed["platform"]
 11235	                derived_chat_type = _parsed["chat_type"]
 11236	                derived_chat_id = _parsed["chat_id"]
 11237	
 11238	        platform_name = str(evt.get("platform") or derived_platform or "").strip().lower()
 11239	        chat_type = str(evt.get("chat_type") or derived_chat_type or "").strip().lower()
 11240	        chat_id = str(evt.get("chat_id") or derived_chat_id or "").strip()
 11241	        if not platform_name or not chat_type or not chat_id:
 11242	            return None
 11243	
 11244	        try:
 11245	            platform = Platform(platform_name)
 11246	            # Reject arbitrary strings that create dynamic pseudo-members.
 11247	            # Built-in platforms are always valid; plugin platforms must be
 11248	            # registered in the platform registry.
 11249	            if platform.value not in _BUILTIN_PLATFORM_VALUES:
 11250	                try:
 11251	                    from gateway.platform_registry import platform_registry
 11252	                    if not platform_registry.is_registered(platform.value):
 11253	                        raise ValueError(platform_name)
 11254	                except Exception:
 11255	                    raise ValueError(platform_name)
 11256	        except Exception:
 11257	            logger.warning(
 11258	                "Synthetic process event has invalid platform metadata: %r",
 11259	                platform_name,
 11260	            )
 11261	            return None
 11262	
 11263	        return SessionSource(
 11264	            platform=platform,
 11265	            chat_id=chat_id,
 11266	            chat_type=chat_type,
 11267	            thread_id=str(evt.get("thread_id") or "").strip() or None,
 11268	            user_id=str(evt.get("user_id") or "").strip() or None,
 11269	            user_name=str(evt.get("user_name") or "").strip() or None,
 11270	        )
 11271	
 11272	    async def _inject_watch_notification(self, synth_text: str, evt: dict) -> None:
 11273	        """Inject a watch-pattern notification as a synthetic message event.
 11274	
 11275	        Routing must come from the queued watch event itself, not from whatever
 11276	        foreground message happened to be active when the queue was drained.
 11277	        """
 11278	        source = self._build_process_event_source(evt)
 11279	        if not source:
 11280	            logger.warning(
 11281	                "Dropping watch notification with no routing metadata for process %s",
 11282	                evt.get("session_id", "unknown"),
 11283	            )
 11284	            return
 11285	        platform_name = source.platform.value if hasattr(source.platform, "value") else str(source.platform)
 11286	        adapter = None
 11287	        for p, a in self.adapters.items():
 11288	            if p.value == platform_name:
 11289	                adapter = a
 11290	                break
 11291	        if not adapter:
 11292	            return
 11293	        try:
 11294	            synth_event = MessageEvent(
 11295	                text=synth_text,
 11296	                message_type=MessageType.TEXT,
 11297	                source=source,
 11298	                internal=True,
 11299	            )
 11300	            logger.info(
 11301	                "Watch pattern notification — injecting for %s chat=%s thread=%s",
 11302	                platform_name,
 11303	                source.chat_id,
 11304	                source.thread_id,
 11305	            )
 11306	            await adapter.handle_message(synth_event)
 11307	        except Exception as e:
 11308	            logger.error("Watch notification injection error: %s", e)
 11309	
 11310	    async def _run_process_watcher(self, watcher: dict) -> None:
 11311	        """
 11312	        Periodically check a background process and push updates to the user.
 11313	
 11314	        Runs as an asyncio task. Stays silent when nothing changed.
 11315	        Auto-removes when the process exits or is killed.
 11316	
 11317	        Notification mode (from ``display.background_process_notifications``):
 11318	          - ``all``    — running-output updates + final message
 11319	          - ``result`` — final completion message only
 11320	          - ``error``  — final message only when exit code != 0
 11321	          - ``off``    — no messages at all
 11322	        """
 11323	        from tools.process_registry import process_registry
 11324	
 11325	        session_id = watcher["session_id"]
 11326	        interval = watcher["check_interval"]
 11327	        session_key = watcher.get("session_key", "")
 11328	        platform_name = watcher.get("platform", "")
 11329	        chat_id = watcher.get("chat_id", "")
 11330	        thread_id = watcher.get("thread_id", "")
 11331	        user_id = watcher.get("user_id", "")
 11332	        user_name = watcher.get("user_name", "")
 11333	        agent_notify = watcher.get("notify_on_complete", False)
 11334	        notify_mode = self._load_background_notifications_mode()
 11335	
 11336	        logger.debug("Process watcher started: %s (every %ss, notify=%s, agent_notify=%s)",
 11337	                      session_id, interval, notify_mode, agent_notify)
 11338	
 11339	        if notify_mode == "off" and not agent_notify:
 11340	            # Still wait for the process to exit so we can log it, but don't
 11341	            # push any messages to the user.
 11342	            while True:
 11343	                await asyncio.sleep(interval)
 11344	                session = process_registry.get(session_id)
 11345	                if session is None or session.exited:
 11346	                    break
 11347	            logger.debug("Process watcher ended (silent): %s", session_id)
 11348	            return
 11349	
 11350	        last_output_len = 0
 11351	        while True:
 11352	            await asyncio.sleep(interval)
 11353	
 11354	            session = process_registry.get(session_id)
 11355	            if session is None:
 11356	                break
 11357	
 11358	            current_output_len = len(session.output_buffer)
 11359	            has_new_output = current_output_len > last_output_len
 11360	            last_output_len = current_output_len
 11361	
 11362	            if session.exited:
 11363	                # --- Agent-triggered completion: inject synthetic message ---
 11364	                # Skip if the agent already consumed the result via wait/poll/log
 11365	                from tools.process_registry import process_registry as _pr_check
 11366	                if agent_notify and not _pr_check.is_completion_consumed(session_id):
 11367	                    from tools.ansi_strip import strip_ansi
 11368	                    _out = strip_ansi(session.output_buffer[-2000:]) if session.output_buffer else ""
 11369	                    synth_text = (
 11370	                        f"[IMPORTANT: Background process {session_id} completed "
 11371	                        f"(exit code {session.exit_code}).\n"
 11372	                        f"Command: {session.command}\n"
 11373	                        f"Output:\n{_out}]"
 11374	                    )
 11375	                    source = self._build_process_event_source({
 11376	                        "session_id": session_id,
 11377	                        "session_key": session_key,
 11378	                        "platform": platform_name,
 11379	                        "chat_id": chat_id,
 11380	                        "thread_id": thread_id,
 11381	                        "user_id": user_id,
 11382	                        "user_name": user_name,
 11383	                    })
 11384	                    if not source:
 11385	                        logger.warning(
 11386	                            "Dropping completion notification with no routing metadata for process %s",
 11387	                            session_id,
 11388	                        )
 11389	                        break
 11390	
 11391	                    adapter = None
 11392	                    for p, a in self.adapters.items():
 11393	                        if p == source.platform:
 11394	                            adapter = a
 11395	                            break
 11396	                    if adapter and source.chat_id:
 11397	                        try:
 11398	                            synth_event = MessageEvent(
 11399	                                text=synth_text,
 11400	                                message_type=MessageType.TEXT,
 11401	                                source=source,
 11402	                                internal=True,
 11403	                            )
 11404	                            logger.info(
 11405	                                "Process %s finished — injecting agent notification for session %s chat=%s thread=%s",
 11406	                                session_id,
 11407	                                session_key,
 11408	                                source.chat_id,
 11409	                                source.thread_id,
 11410	                            )
 11411	                            await adapter.handle_message(synth_event)
 11412	                        except Exception as e:
 11413	                            logger.error("Agent notify injection error: %s", e)
 11414	                    break
 11415	
 11416	                # --- Normal text-only notification ---
 11417	                # Decide whether to notify based on mode
 11418	                should_notify = (
 11419	                    notify_mode in ("all", "result")
 11420	                    or (notify_mode == "error" and session.exit_code not in (0, None))
 11421	                )
 11422	                if should_notify:
 11423	                    new_output = session.output_buffer[-1000:] if session.output_buffer else ""
 11424	                    message_text = (
 11425	                        f"[Background process {session_id} finished with exit code {session.exit_code}~ "
 11426	                        f"Here's the final output:\n{new_output}]"
 11427	                    )
 11428	                    adapter = None
 11429	                    for p, a in self.adapters.items():
 11430	                        if p.value == platform_name:
 11431	                            adapter = a
 11432	                            break
 11433	                    if adapter and chat_id:
 11434	                        try:
 11435	                            send_meta = {"thread_id": thread_id} if thread_id else None
 11436	                            await adapter.send(chat_id, message_text, metadata=send_meta)
 11437	                        except Exception as e:
 11438	                            logger.error("Watcher delivery error: %s", e)
 11439	                break
 11440	
 11441	            elif has_new_output and notify_mode == "all" and not agent_notify:
 11442	                # New output available -- deliver status update (only in "all" mode)
 11443	                # Skip periodic updates for agent_notify watchers (they only care about completion)
 11444	                new_output = session.output_buffer[-500:] if session.output_buffer else ""
 11445	                message_text = (
 11446	                    f"[Background process {session_id} is still running~ "
 11447	                    f"New output:\n{new_output}]"
 11448	                )
 11449	                adapter = None
 11450	                for p, a in self.adapters.items():
 11451	                    if p.value == platform_name:
 11452	                        adapter = a
 11453	                        break
 11454	                if adapter and chat_id:
 11455	                    try:
 11456	                        send_meta = {"thread_id": thread_id} if thread_id else None
 11457	                        await adapter.send(chat_id, message_text, metadata=send_meta)
 11458	                    except Exception as e:
 11459	                        logger.error("Watcher delivery error: %s", e)
 11460	
 11461	        logger.debug("Process watcher ended: %s", session_id)
 11462	
 11463	    _MAX_INTERRUPT_DEPTH = 3  # Cap recursive interrupt handling (#816)
 11464	
 11465	    # Config keys whose values MUST invalidate the gateway's cached agent
 11466	    # when they change.  The agent bakes these into its compressor / context
 11467	    # handling at construction time, so a mid-running-gateway config edit
 11468	    # would otherwise be silently ignored until the user triggers a
 11469	    # different cache eviction (model switch, /reset, etc.).
 11470	    #
 11471	    # Each entry is a tuple of (section, key) read from the raw config dict.
 11472	    # Add more here as new baked-at-construction config settings are added.
 11473	    _CACHE_BUSTING_CONFIG_KEYS: tuple = (
 11474	        ("model", "context_length"),
 11475	        ("compression", "enabled"),
 11476	        ("compression", "threshold"),
 11477	        ("compression", "target_ratio"),
 11478	        ("compression", "protect_last_n"),
 11479	        ("agent", "disabled_toolsets"),
 11480	    )
 11481	
 11482	    @classmethod
 11483	    def _extract_cache_busting_config(cls, user_config: dict | None) -> dict:
 11484	        """Pull values that must bust the cached agent.
 11485	
 11486	        Returns a flat dict keyed by 'section.key'.  Missing config keys and
 11487	        non-dict sections yield None values, which still contribute to the
 11488	        signature (so 'absent' vs 'present-and-null' differ).
 11489	
 11490	        The live tool registry generation is included too.  MCP reloads and
 11491	        dynamic MCP tool-list changes mutate the registry without necessarily
 11492	        changing config.yaml.  Cached AIAgent instances freeze their tool
 11493	        schemas at construction time, so a registry generation change must
 11494	        rebuild the agent before the next turn.
 11495	        """
 11496	        out: Dict[str, Any] = {}
 11497	        cfg = user_config if isinstance(user_config, dict) else {}
 11498	        for section, key in cls._CACHE_BUSTING_CONFIG_KEYS:
 11499	            section_val = cfg.get(section)
 11500	            if isinstance(section_val, dict):
 11501	                out[f"{section}.{key}"] = section_val.get(key)
 11502	            else:
 11503	                out[f"{section}.{key}"] = None
 11504	        try:
 11505	            from tools.registry import registry
 11506	
 11507	            out["tools.registry_generation"] = getattr(registry, "_generation", None)
 11508	        except Exception:
 11509	            out["tools.registry_generation"] = None
 11510	        return out
 11511	
 11512	    @staticmethod
 11513	    def _agent_config_signature(
 11514	        model: str,
 11515	        runtime: dict,
 11516	        enabled_toolsets: list,
 11517	        ephemeral_prompt: str,
 11518	        cache_keys: dict | None = None,
 11519	    ) -> str:
 11520	        """Compute a stable string key from agent config values.
 11521	
 11522	        When this signature changes between messages, the cached AIAgent is
 11523	        discarded and rebuilt.  When it stays the same, the cached agent is
 11524	        reused — preserving the frozen system prompt and tool schemas for
 11525	        prompt cache hits.
 11526	
 11527	        ``cache_keys`` is an optional flat dict of additional config values
 11528	        that should invalidate the cache when they change.  Callers pass
 11529	        the output of ``_extract_cache_busting_config(user_config)`` so
 11530	        edits to model.context_length / compression.* in config.yaml are
 11531	        picked up on the next gateway message without a manual restart.
 11532	        """
 11533	        import hashlib, json as _j
 11534	
 11535	        # Fingerprint the FULL credential string instead of using a short
 11536	        # prefix. OAuth/JWT-style tokens frequently share a common prefix
 11537	        # (e.g. "eyJhbGci"), which can cause false cache hits across auth
 11538	        # switches if only the first few characters are considered.
 11539	        _api_key = str(runtime.get("api_key", "") or "")
 11540	        _api_key_fingerprint = hashlib.sha256(_api_key.encode()).hexdigest() if _api_key else ""
 11541	
 11542	        _cache_keys_sorted = sorted((cache_keys or {}).items())
 11543	
 11544	        blob = _j.dumps(
 11545	            [
 11546	                model,
 11547	                _api_key_fingerprint,
 11548	                runtime.get("base_url", ""),
 11549	                runtime.get("provider", ""),
 11550	                runtime.get("api_mode", ""),
 11551	                sorted(enabled_toolsets) if enabled_toolsets else [],
 11552	                # reasoning_config excluded — it's set per-message on the
 11553	                # cached agent and doesn't affect system prompt or tools.
 11554	                ephemeral_prompt or "",
 11555	                _cache_keys_sorted,
 11556	            ],
 11557	            sort_keys=True,
 11558	            default=str,
 11559	        )
 11560	        return hashlib.sha256(blob.encode()).hexdigest()[:16]
 11561	
 11562	    def _apply_session_model_override(
 11563	        self, session_key: str, model: str, runtime_kwargs: dict
 11564	    ) -> tuple:
 11565	        """Apply /model session overrides if present, returning (model, runtime_kwargs).
 11566	
 11567	        The gateway /model command stores per-session overrides in
 11568	        ``_session_model_overrides``.  These must take precedence over
 11569	        config.yaml defaults so the switched model is actually used for
 11570	        subsequent messages.  Fields with ``None`` values are skipped so
 11571	        partial overrides don't clobber valid config defaults.
 11572	        """
 11573	        override = self._session_model_overrides.get(session_key)
 11574	        if not override:
 11575	            return model, runtime_kwargs
 11576	        model = override.get("model", model)
 11577	        for key in ("provider", "api_key", "base_url", "api_mode"):
 11578	            val = override.get(key)
 11579	            if val is not None:
 11580	                runtime_kwargs[key] = val
 11581	        return model, runtime_kwargs
 11582	
 11583	    def _is_intentional_model_switch(self, session_key: str, agent_model: str) -> bool:
 11584	        """Return True if *agent_model* matches an active /model session override."""
 11585	        override = self._session_model_overrides.get(session_key)
 11586	        return override is not None and override.get("model") == agent_model
 11587	
 11588	    def _release_running_agent_state(
 11589	        self,
 11590	        session_key: str,
 11591	        *,
 11592	        run_generation: Optional[int] = None,
 11593	    ) -> bool:
 11594	        """Pop ALL per-running-agent state entries for ``session_key``.
 11595	
 11596	        Replaces ad-hoc ``del self._running_agents[key]`` calls scattered
 11597	        across the gateway.  Those sites had drifted: some popped only
 11598	        ``_running_agents``; some also ``_running_agents_ts``; only one
 11599	        path also cleared ``_busy_ack_ts``.  Each missed entry was a
 11600	        small, persistent leak — a (str_key → float) tuple per session
 11601	        per gateway lifetime.
 11602	
 11603	        Use this at every site that ends a running turn, regardless of
 11604	        cause (normal completion, /stop, /reset, /resume, sentinel
 11605	        cleanup, stale-eviction).  Per-session state that PERSISTS
 11606	        across turns (``_session_model_overrides``, ``_voice_mode``,
 11607	        ``_pending_approvals``, ``_update_prompt_pending``) is NOT
 11608	        touched here — those have their own lifecycles.
 11609	
 11610	        When ``run_generation`` is provided, only clear the slot if that
 11611	        generation is still current for the session.  This prevents an
 11612	        older async run whose generation was bumped by /stop or /new from
 11613	        clobbering a newer run's state during its own unwind.  Returns
 11614	        True when the slot was cleared, False when an ownership guard
 11615	        blocked it.
 11616	        """
 11617	        if not session_key:
 11618	            return False
 11619	        if run_generation is not None and not self._is_session_run_current(
 11620	            session_key, run_generation
 11621	        ):
 11622	            return False
 11623	        self._running_agents.pop(session_key, None)
 11624	        self._running_agents_ts.pop(session_key, None)
 11625	        if hasattr(self, "_busy_ack_ts"):
 11626	            self._busy_ack_ts.pop(session_key, None)
 11627	        # Clear busy-session UI bookkeeping in-memory.  Adapter-side
 11628	        # teardown (deleting the control bubble, removing the keyboard)
 11629	        # is handled by the async ``_clear_busy_session_controls`` from
 11630	        # ``_run_agent``'s finally block and from
 11631	        # ``_interrupt_and_clear_session``; this sync path runs from
 11632	        # contexts that have no event loop access.  ``hasattr`` guards
 11633	        # mirror the ``_busy_ack_ts`` pattern so test fixtures that
 11634	        # bypass ``__init__`` (object.__new__(GatewayRunner)) don't
 11635	        # AttributeError on cleanup paths.
 11636	        if hasattr(self, "_tool_bubble_msg_ids"):
 11637	            self._tool_bubble_msg_ids.pop(session_key, None)
 11638	        if hasattr(self, "_busy_control_bubble_ids"):
 11639	            self._busy_control_bubble_ids.pop(session_key, None)
 11640	        if hasattr(self, "_pending_followups"):
 11641	            self._pending_followups.pop(session_key, None)
 11642	        return True
 11643	
 11644	    def _clear_session_boundary_security_state(self, session_key: str) -> None:
 11645	        """Clear per-session control state that must not survive a boundary switch."""
 11646	        if not session_key:
 11647	            return
 11648	
 11649	        pending_approvals = getattr(self, "_pending_approvals", None)
 11650	        if isinstance(pending_approvals, dict):
 11651	            pending_approvals.pop(session_key, None)
 11652	
 11653	        update_prompt_pending = getattr(self, "_update_prompt_pending", None)
 11654	        if isinstance(update_prompt_pending, dict):
 11655	            update_prompt_pending.pop(session_key, None)
 11656	
 11657	        try:
 11658	            from tools.approval import clear_session as _clear_approval_session
 11659	        except Exception:
 11660	            return
 11661	
 11662	        try:
 11663	            _clear_approval_session(session_key)
 11664	        except Exception as e:
 11665	            logger.debug(
 11666	                "Failed to clear approval state for session boundary %s: %s",
 11667	                session_key,
 11668	                e,
 11669	            )
 11670	
 11671	    def _begin_session_run_generation(self, session_key: str) -> int:
 11672	        """Claim a fresh run generation token for ``session_key``.
 11673	
 11674	        Every top-level gateway turn gets a monotonically increasing token.
 11675	        If a later command like /stop or /new invalidates that token while the
 11676	        old worker is still unwinding, the late result can be recognized and
 11677	        dropped instead of bleeding into the fresh session.
 11678	        """
 11679	        if not session_key:
 11680	            return 0
 11681	        generations = self.__dict__.get("_session_run_generation")
 11682	        if generations is None:
 11683	            generations = {}
 11684	            self._session_run_generation = generations
 11685	        next_generation = int(generations.get(session_key, 0)) + 1
 11686	        generations[session_key] = next_generation
 11687	        return next_generation
 11688	
 11689	    def _invalidate_session_run_generation(self, session_key: str, *, reason: str = "") -> int:
 11690	        """Invalidate any in-flight run token for ``session_key``."""
 11691	        generation = self._begin_session_run_generation(session_key)
 11692	        if reason:
 11693	            logger.info(
 11694	                "Invalidated run generation for %s → %d (%s)",
 11695	                session_key,
 11696	                generation,
 11697	                reason,
 11698	            )
 11699	        return generation
