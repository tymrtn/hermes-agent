  2618	                await adapter.clear_busy_session_buttons(session_key, ack_msg_id)
  2619	            except Exception:
  2620	                pass
  2621	        try:
  2622	            await adapter.edit_message(
  2623	                chat_id=chat_id,
  2624	                message_id=ack_msg_id,
  2625	                content=new_text,
  2626	            )
