  1095	# Error substrings that indicate a transient *connection* failure worth retrying.
  1096	# "timeout" / "timed out" / "readtimeout" / "writetimeout" are intentionally
  1097	# excluded: a read/write timeout on a non-idempotent call (e.g. send_message)
  1098	# means the request may have reached the server — retrying risks duplicate
  1099	# delivery.  "connecttimeout" is safe because the connection was never
  1100	# established.  Platforms that know a timeout is safe to retry should set
  1101	# SendResult.retryable = True explicitly.
  1102	_RETRYABLE_ERROR_PATTERNS = (
  1103	    "connecterror",
  1104	    "connectionerror",
  1105	    "connectionreset",
  1106	    "connectionrefused",
  1107	    "connecttimeout",
  1108	    "network",
  1109	    "broken pipe",
  1110	    "remotedisconnected",
  1111	    "eoferror",
  1112	)
