  2449	def get_missing_config_fields() -> List[Dict[str, Any]]:
  2450	    """
  2451	    Check which config fields are missing or outdated (recursive).
  2452	    
  2453	    Walks the DEFAULT_CONFIG tree at arbitrary depth and reports any keys
  2454	    present in defaults but absent from the user's loaded config.
  2455	    """
  2456	    config = load_config()
  2457	    missing = []
  2458	
  2459	    def _check(defaults: dict, current: dict, prefix: str = ""):
  2460	        for key, default_value in defaults.items():
  2461	            if key.startswith('_'):
  2462	                continue
  2463	            full_key = key if not prefix else f"{prefix}.{key}"
  2464	            if key not in current:
  2465	                missing.append({
  2466	                    "key": full_key,
  2467	                    "default": default_value,
  2468	                    "description": f"New config option: {full_key}",
  2469	                })
  2470	            elif isinstance(default_value, dict) and isinstance(current.get(key), dict):
  2471	                _check(default_value, current[key], full_key)
  2472	
  2473	    _check(DEFAULT_CONFIG, config)
  2474	    return missing
  2475	
  2476	
  2477	def get_missing_skill_config_vars() -> List[Dict[str, Any]]:
  2478	    """Return skill-declared config vars that are missing or empty in config.yaml.
  2479	
  2480	    Scans all enabled skills for ``metadata.hermes.config`` entries, then checks
  2481	    which ones are absent or empty under ``skills.config.<key>`` in the user's
  2482	    config.yaml.  Returns a list of dicts suitable for prompting.
  2483	    """
  2484	    try:
  2485	        from agent.skill_utils import discover_all_skill_config_vars, SKILL_CONFIG_PREFIX
  2486	    except Exception:
  2487	        return []
  2488	
