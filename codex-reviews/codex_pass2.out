  4698	            allowed_user_ids: set,
  4699	            allowed_role_ids: Optional[set] = None,
  4700	        ):
  4701	            # No timeout: a busy-session lives as long as the agent is
  4702	            # busy, which is bounded by the agent's own iteration cap.
