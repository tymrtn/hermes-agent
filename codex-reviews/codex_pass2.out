   473	class DiscordAdapter(BasePlatformAdapter):
   474	    """
   475	    Discord bot adapter.
   476	
   477	    Handles:
   478	    - Receiving messages from servers and DMs
   479	    - Sending responses with Discord markdown
   480	    - Thread support
   481	    - Native slash commands (/ask, /reset, /status, /stop)
   482	    - Button-based exec approvals
   483	    - Auto-threading for long conversations
   484	    - Reaction-based feedback
   485	    """
   486	
   487	    # Discord message limits
   488	    MAX_MESSAGE_LENGTH = 2000
   489	    _SPLIT_THRESHOLD = 1900  # near the 2000-char split point
   490	
   491	    # Auto-disconnect from voice channel after this many seconds of inactivity
   492	    VOICE_TIMEOUT = 300
   493	
   494	    def __init__(self, config: PlatformConfig):
   495	        super().__init__(config, Platform.DISCORD)
   496	        self._client: Optional[commands.Bot] = None
   497	        self._ready_event = asyncio.Event()
   498	        self._allowed_user_ids: set = set()  # For button approval authorization
   499	        self._allowed_role_ids: set = set()  # For DISCORD_ALLOWED_ROLES filtering
   500	        # Busy-session view state: session_key → message_id of the
   501	        # message currently carrying the [Steer][Interrupt][Stop] view.
   502	        # Discord's BusySessionView holds session_key on the view
   503	        # instance directly, so callback_data length isn't a concern here.
   504	        self._busy_session_view_map: Dict[str, str] = {}
   505	        self._busy_control_bubble_ids: Dict[str, str] = {}
   506	        self.gateway_runner = None  # Set by gateway/run.py for cross-platform delivery
   507	        # Voice channel state (per-guild)
   508	        self._voice_clients: Dict[int, Any] = {}  # guild_id -> VoiceClient
   509	        self._voice_locks: Dict[int, asyncio.Lock] = {}  # guild_id -> serialize join/leave
   510	        # Text batching: merge rapid successive messages (Telegram-style)
   511	        self._text_batch_delay_seconds = float(os.getenv("HERMES_DISCORD_TEXT_BATCH_DELAY_SECONDS", "0.6"))
   512	        self._text_batch_split_delay_seconds = float(os.getenv("HERMES_DISCORD_TEXT_BATCH_SPLIT_DELAY_SECONDS", "2.0"))
   513	        self._pending_text_batches: Dict[str, MessageEvent] = {}
   514	        self._pending_text_batch_tasks: Dict[str, asyncio.Task] = {}
   515	        self._voice_text_channels: Dict[int, int] = {}  # guild_id -> text_channel_id
   516	        self._voice_sources: Dict[int, Dict[str, Any]] = {}  # guild_id -> linked text channel source metadata
   517	        self._voice_timeout_tasks: Dict[int, asyncio.Task] = {}  # guild_id -> timeout task
