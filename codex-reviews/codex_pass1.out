  1975	                logger.warning(
  1976	                    "Invalid restart_drain_timeout '%s', using default %.0fs",
  1977	                    raw,
  1978	                    DEFAULT_GATEWAY_RESTART_DRAIN_TIMEOUT,
  1979	                )
  1980	        return value
