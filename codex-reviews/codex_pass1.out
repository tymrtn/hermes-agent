  1966	                        cfg = _y.safe_load(_f) or {}
  1967	                    raw = str(cfg_get(cfg, "agent", "restart_drain_timeout", default="") or "").strip()
  1968	            except Exception:
  1969	                pass
  1970	        value = parse_restart_drain_timeout(raw)
  1971	        if raw and value == DEFAULT_GATEWAY_RESTART_DRAIN_TIMEOUT:
  1972	            try:
  1973	                float(raw)
