   210	def _no_proxy_entries() -> list[str]:
   211	    entries: list[str] = []
   212	    for key in ("NO_PROXY", "no_proxy"):
   213	        raw = os.environ.get(key, "")
   214	        entries.extend(part.strip() for part in raw.split(",") if part.strip())
   215	    return entries
   216	
   217	
   218	def _no_proxy_entry_matches(entry: str, host: str, port: int | None = None) -> bool:
   219	    token = str(entry or "").strip().lower()
   220	    if not token:
   221	        return False
   222	    if token == "*":
   223	        return True
   224	
   225	    token_host, token_port = _split_host_port(token)
   226	    if token_port is not None and port is not None and token_port != port:
   227	        return False
   228	    if token_port is not None and port is None:
   229	        return False
   230	    if not token_host:
   231	        return False
   232	
   233	    try:
   234	        network = ipaddress.ip_network(token_host, strict=False)
   235	        try:
   236	            return ipaddress.ip_address(host) in network
   237	        except ValueError:
   238	            return False
   239	    except ValueError:
   240	        pass
   241	
   242	    try:
   243	        token_ip = ipaddress.ip_address(token_host)
   244	        try:
   245	            return ipaddress.ip_address(host) == token_ip
   246	        except ValueError:
   247	            return False
   248	    except ValueError:
   249	        pass
   250	
   251	    if token_host.startswith("*."):
   252	        suffix = token_host[1:]
   253	        return host.endswith(suffix)
   254	    if token_host.startswith("."):
   255	        return host == token_host[1:] or host.endswith(token_host)
   256	    return host == token_host or host.endswith(f".{token_host}")
   257	
   258	
   259	def should_bypass_proxy(target_hosts: str | list[str] | tuple[str, ...] | set[str] | None) -> bool:
   260	    """Return True when NO_PROXY/no_proxy matches at least one target host.
   261	
   262	    Supports exact hosts, domain suffixes, wildcard suffixes, IP literals,
   263	    CIDR ranges, optional host:port entries, and ``*``.
   264	    """
   265	    entries = _no_proxy_entries()
   266	    if not entries or not target_hosts:
   267	        return False
   268	    if isinstance(target_hosts, str):
   269	        candidates = [target_hosts]
   270	    else:
   271	        candidates = list(target_hosts)
   272	    for candidate in candidates:
   273	        host, port = _split_host_port(str(candidate))
   274	        if not host:
   275	            continue
   276	        if any(_no_proxy_entry_matches(entry, host, port) for entry in entries):
   277	            return True
   278	    return False
   279	
   280	
