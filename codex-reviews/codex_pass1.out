  2523	    async def _drain_active_agents(self, timeout: float) -> tuple[Dict[str, Any], bool]:
  2524	        snapshot = self._snapshot_running_agents()
  2525	        last_active_count = self._running_agent_count()
  2526	        last_status_at = 0.0
  2527	
  2528	        def _maybe_update_status(force: bool = False) -> None:
  2529	            nonlocal last_active_count, last_status_at
  2530	            now = asyncio.get_running_loop().time()
  2531	            active_count = self._running_agent_count()
  2532	            if force or active_count != last_active_count or (now - last_status_at) >= 1.0:
  2533	                self._update_runtime_status("draining")
  2534	                last_active_count = active_count
  2535	                last_status_at = now
  2536	
  2537	        if not self._running_agents:
  2538	            _maybe_update_status(force=True)
  2539	            return snapshot, False
  2540	
  2541	        _maybe_update_status(force=True)
  2542	        if timeout <= 0:
  2543	            return snapshot, True
  2544	
  2545	        deadline = asyncio.get_running_loop().time() + timeout
  2545	        deadline = asyncio.get_running_loop().time() + timeout
  2546	        while self._running_agents and asyncio.get_running_loop().time() < deadline:
  2547	            _maybe_update_status()
  2548	            await asyncio.sleep(0.1)
  2549	        timed_out = bool(self._running_agents)
  2550	        _maybe_update_status(force=True)
  2551	        return snapshot, timed_out
  2552	
  2553	    def _interrupt_running_agents(self, reason: str) -> None:
  2554	        for session_key, agent in list(self._running_agents.items()):
  2555	            if agent is _AGENT_PENDING_SENTINEL:
  2556	                continue
  2557	            try:
  2558	                agent.interrupt(reason)
  2559	                logger.debug("Interrupted running agent for session %s during shutdown", session_key)
  2560	            except Exception as e:
  2561	                logger.debug("Failed interrupting agent during shutdown: %s", e)
  2562	
  2563	    async def _notify_active_sessions_of_shutdown(self) -> None:
  2564	        """Send a notification to every chat with an active agent.
  2565	
  2566	        Called at the very start of stop() — adapters are still connected so
  2567	        messages can be delivered.  Best-effort: individual send failures are
  2568	        logged and swallowed so they never block the shutdown sequence.
  2569	        """
  2570	        active = self._snapshot_running_agents()
  2571	        if not active:
  2572	            return
  2573	
  2574	        action = "restarting" if self._restart_requested else "shutting down"
  2575	        hint = (
  2576	            "Your current task will be interrupted. "
  2577	            "Send any message after restart and I'll try to resume where you left off."
  2578	            if self._restart_requested
  2579	            else "Your current task will be interrupted."
  2580	        )
  2581	        msg = f"⚠️ Gateway {action} — {hint}"
  2582	
  2583	        notified: set = set()
  2584	        for session_key in active:
  2585	            source = None
  2586	            try:
  2587	                if getattr(self, "session_store", None) is not None:
  2588	                    self.session_store._ensure_loaded()
  2589	                    entry = self.session_store._entries.get(session_key)
  2590	                    source = getattr(entry, "origin", None) if entry else None
  2591	            except Exception as e:
  2592	                logger.debug(
  2593	                    "Failed to load session origin for shutdown notification %s: %s",
  2594	                    session_key,
  2595	                    e,
  2596	                )
  2597	
  2598	            if source is not None:
  2599	                platform_str = source.platform.value
  2600	                chat_id = source.chat_id
  2601	                thread_id = source.thread_id
  2602	            else:
  2603	                # Fall back to parsing the session key when no persisted
  2604	                # origin is available (legacy sessions/tests).
  2605	                _parsed = _parse_session_key(session_key)
  2606	                if not _parsed:
  2607	                    continue
  2608	                platform_str = _parsed["platform"]
  2609	                chat_id = _parsed["chat_id"]
  2610	                thread_id = _parsed.get("thread_id")
  2611	
  2612	            # Deduplicate: one notification per chat, even if multiple
  2613	            # sessions (different users/threads) share the same chat.
  2614	            dedup_key = (platform_str, chat_id)
  2615	            if dedup_key in notified:
  2616	                continue
  2617	
  2618	            try:
  2619	                platform = Platform(platform_str)
  2620	                adapter = self.adapters.get(platform)
  2621	                if not adapter:
  2622	                    continue
  2623	
  2624	                # Include thread_id if present so the message lands in the
  2625	                # correct forum topic / thread.
  2626	                metadata = {"thread_id": thread_id} if thread_id else None
  2627	
  2628	                await adapter.send(chat_id, msg, metadata=metadata)
  2629	                notified.add(dedup_key)
  2630	                logger.info(
  2631	                    "Sent shutdown notification to %s:%s",
  2632	                    platform_str, chat_id,
  2633	                )
  2634	            except Exception as e:
  2635	                logger.debug(
  2636	                    "Failed to send shutdown notification to %s:%s: %s",
  2637	                    platform_str, chat_id, e,
  2638	                )
  2639	
  2640	    def _finalize_shutdown_agents(self, active_agents: Dict[str, Any]) -> None:
  2641	        for agent in active_agents.values():
  2642	            try:
  2643	                from hermes_cli.plugins import invoke_hook as _invoke_hook
  2644	                _invoke_hook(
  2645	                    "on_session_finalize",
  3460	                await asyncio.sleep(1)
  3461	
  3462	    async def _kanban_notifier_watcher(self, interval: float = 5.0) -> None:
  3463	        """Poll ``kanban_notify_subs`` and deliver terminal events to users.
  3464	
  3465	        For each subscription row, fetches ``task_events`` newer than the
  3466	        stored cursor with kind in the terminal set (``completed``,
  3467	        ``blocked``, ``gave_up``, ``crashed``, ``timed_out``). Sends one
  3468	        message per new event to ``(platform, chat_id, thread_id)``,
  3469	        then advances the cursor. When a task reaches a terminal state
  3470	        (``completed`` / ``archived``), the subscription is removed.
  3471	
  3472	        Runs in the gateway event loop; all SQLite work is pushed to a
  3473	        thread via ``asyncio.to_thread`` so the loop never blocks on the
  3474	        WAL lock. Failures in one tick don't stop subsequent ticks.
  3475	        """
  3476	        from gateway.config import Platform as _Platform
  3477	        try:
  3478	            from hermes_cli import kanban_db as _kb
  3479	        except Exception:
  3480	            logger.warning("kanban notifier: kanban_db not importable; notifier disabled")
  3481	            return
  3482	
  3483	        TERMINAL_KINDS = ("completed", "blocked", "gave_up", "crashed", "timed_out")
  3484	        # Terminal event kinds trigger automatic unsubscription — the task
  3485	        # is done, blocked, or in a retry-needed state that the human
  3486	        # shouldn't keep pinging a stale chat for. Previously we only
  3487	        # unsubbed when task.status in ('done', 'archived'), which left
  3488	        # subscriptions on 'blocked' / 'gave_up' / 'crashed' / 'timed_out'
  3489	        # tasks stranded forever.
  3490	        TERMINAL_EVENT_KINDS = TERMINAL_KINDS
  3491	        # Per-subscription send-failure counter. Adapter.send raising
  3492	        # means the chat is dead (deleted, bot kicked, etc.) — after N
  3493	        # consecutive send failures the sub is dropped so we don't spin
  3494	        # against a dead chat every 5 seconds forever.
  3495	        MAX_SEND_FAILURES = 3
  3496	        sub_fail_counts: dict[tuple, int] = getattr(
  3497	            self, "_kanban_sub_fail_counts", {}
  3498	        )
  3499	        self._kanban_sub_fail_counts = sub_fail_counts
  3500	
  3501	        # Initial delay so the gateway can finish wiring adapters.
  3502	        await asyncio.sleep(5)
  3503	
  3504	        while self._running:
  3505	            try:
  3506	                def _collect():
  3507	                    conn = _kb.connect()
  3508	                    try:
  3509	                        _kb.init_db()  # idempotent; handles first-run
  3510	                    except Exception:
  3511	                        pass
  3512	                    try:
  3513	                        subs = _kb.list_notify_subs(conn)
  3514	                        deliveries: list[dict] = []
  3515	                        for sub in subs:
  3516	                            cursor, events = _kb.unseen_events_for_sub(
  3517	                                conn,
  3518	                                task_id=sub["task_id"],
  3519	                                platform=sub["platform"],
  3520	                                chat_id=sub["chat_id"],
  3521	                                thread_id=sub.get("thread_id") or "",
  3522	                                kinds=TERMINAL_KINDS,
  3523	                            )
  3524	                            if not events:
  3525	                                continue
  3526	                            task = _kb.get_task(conn, sub["task_id"])
  3527	                            deliveries.append({
  3528	                                "sub": sub,
  3529	                                "cursor": cursor,
  3530	                                "events": events,
  3531	                                "task": task,
  3532	                            })
  3533	                        return deliveries
  3534	                    finally:
  3535	                        conn.close()
  3536	
  3537	                deliveries = await asyncio.to_thread(_collect)
  3538	                for d in deliveries:
  3539	                    sub = d["sub"]
  3540	                    task = d["task"]
  3541	                    platform_str = (sub["platform"] or "").lower()
  3542	                    try:
  3543	                        plat = _Platform(platform_str)
  3544	                    except ValueError:
  3545	                        # Unknown platform string; skip and advance cursor so
  3546	                        # we don't replay forever.
  3547	                        await asyncio.to_thread(
  3548	                            self._kanban_advance, sub, d["cursor"],
  3549	                        )
  3550	                        continue
  3551	                    adapter = self.adapters.get(plat)
  3552	                    if adapter is None:
  3553	                        continue  # platform not currently connected
  3554	                    title = (task.title if task else sub["task_id"])[:120]
  3555	                    for ev in d["events"]:
  3556	                        kind = ev.kind
  3557	                        # Identity prefix: attribute terminal pings to the
  3558	                        # worker that did the work. Makes fleets (where one
  3559	                        # chat subscribes to many tasks) legible at a glance.
  3560	                        who = (task.assignee if task and task.assignee else None)
  3561	                        tag = f"@{who} " if who else ""
  3562	                        if kind == "completed":
  3563	                            # Prefer the run's summary (the worker's
  3564	                            # intentional human-facing handoff, carried
  3565	                            # in the event payload), then fall back to
  3566	                            # task.result for legacy rows written before
  3567	                            # runs shipped.
  3568	                            handoff = ""
  3569	                            payload_summary = None
  3570	                            if ev.payload and ev.payload.get("summary"):
  3571	                                payload_summary = str(ev.payload["summary"])
  3572	                            if payload_summary:
  3573	                                h = payload_summary.strip().splitlines()[0][:200]
  3574	                                handoff = f"\n{h}"
  3575	                            elif task and task.result:
  3576	                                r = task.result.strip().splitlines()[0][:160]
  3577	                                handoff = f"\n{r}"
  3578	                            msg = (
  3579	                                f"✔ {tag}Kanban {sub['task_id']} done"
  3580	                                f" — {title}{handoff}"
  3581	                            )
  3582	                        elif kind == "blocked":
  3583	                            reason = ""
  3584	                            if ev.payload and ev.payload.get("reason"):
  3585	                                reason = f": {str(ev.payload['reason'])[:160]}"
  4700	            return
  4701	
  4702	        config = getattr(self, "config", None)
  4703	        notice_delivery = "public"
  4704	        if config and hasattr(config, "get_notice_delivery"):
  4705	            notice_delivery = config.get_notice_delivery(source.platform)
  4706	
  4707	        metadata = {"thread_id": source.thread_id} if getattr(source, "thread_id", None) else None
  4708	        if notice_delivery == "private" and getattr(source, "user_id", None):
  4709	            try:
  4710	                result = await adapter.send_private_notice(
