  2923	    def _slack_free_response_channels(self) -> set:
  2924	        """Return channel IDs where no @mention is required."""
  2925	        raw = self.config.extra.get("free_response_channels")
  2926	        if raw is None:
  2927	            raw = os.getenv("SLACK_FREE_RESPONSE_CHANNELS", "")
  2928	        if isinstance(raw, list):
  2929	            return {str(part).strip() for part in raw if str(part).strip()}
  2930	        # Coerce non-list scalars (str/int/float) to str before splitting.
  2931	        # A bare numeric YAML value (`free_response_channels: 1234567890`) is
  2932	        # loaded as int and was previously falling through the isinstance(str)
  2933	        # branch to return an empty set.  str() here accepts whatever scalar
  2934	        # the YAML loader hands us without changing existing string/CSV
  2935	        # semantics.
  2936	        s = str(raw).strip() if raw is not None else ""
  2937	        if s:
  2938	            return {part.strip() for part in s.split(",") if part.strip()}
  2939	        return set()
