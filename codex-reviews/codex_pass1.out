    77	# Module-level cache for bundled platform plugin names (lives outside the
    78	# enum so it doesn't become an accidental enum member).
    79	_Platform__bundled_plugin_names: Optional[set] = None
    80	
    81	
    82	class Platform(Enum):
    83	    """Supported messaging platforms.
    84	
    85	    Built-in platforms have explicit members.  Plugin platforms use dynamic
    86	    members created on-demand by ``_missing_()`` so that
    87	    ``Platform("irc")`` works without modifying this enum.  Dynamic members
    88	    are cached in ``_value2member_map_`` for identity-stable comparisons.
    89	    """
    90	    LOCAL = "local"
    91	    TELEGRAM = "telegram"
    92	    DISCORD = "discord"
    93	    WHATSAPP = "whatsapp"
    94	    SLACK = "slack"
    95	    SIGNAL = "signal"
    96	    MATTERMOST = "mattermost"
    97	    MATRIX = "matrix"
    98	    HOMEASSISTANT = "homeassistant"
    99	    EMAIL = "email"
   100	    SMS = "sms"
   101	    DINGTALK = "dingtalk"
   102	    API_SERVER = "api_server"
   103	    WEBHOOK = "webhook"
   104	    FEISHU = "feishu"
   105	    WECOM = "wecom"
   106	    WECOM_CALLBACK = "wecom_callback"
   107	    WEIXIN = "weixin"
   108	    BLUEBUBBLES = "bluebubbles"
   109	    QQBOT = "qqbot"
   110	    YUANBAO = "yuanbao"
   111	    @classmethod
   112	    def _missing_(cls, value):
   113	        """Accept unknown platform names only for known plugin adapters.
   114	
   115	        Creates a pseudo-member cached in ``_value2member_map_`` so that
   116	        ``Platform("irc") is Platform("irc")`` holds True (identity-stable).
   117	        Arbitrary strings are rejected to prevent enum pollution.
   118	        """
   119	        if not isinstance(value, str) or not value.strip():
   120	            return None
   121	        # Normalise to lowercase to avoid case mismatches in config
   122	        value = value.strip().lower()
   123	        # Check cache first (another call may have created it already)
   124	        if value in cls._value2member_map_:
   125	            return cls._value2member_map_[value]
   126	
   127	        # Only create pseudo-members for bundled plugin platforms (discovered
   128	        # via filesystem scan) or runtime-registered plugin platforms.
   129	        global _Platform__bundled_plugin_names
   130	        if _Platform__bundled_plugin_names is None:
   131	            _Platform__bundled_plugin_names = cls._scan_bundled_plugin_platforms()
   132	        if value in _Platform__bundled_plugin_names:
   133	            pseudo = object.__new__(cls)
   134	            pseudo._value_ = value
   135	            pseudo._name_ = value.upper().replace("-", "_").replace(" ", "_")
   136	            cls._value2member_map_[value] = pseudo
   137	            cls._member_map_[pseudo._name_] = pseudo
   138	            return pseudo
   139	
   140	        # Runtime-registered plugins (e.g. user-installed, discovered after
   141	        # the enum was defined).
   142	        try:
   143	            from gateway.platform_registry import platform_registry
   144	            if platform_registry.is_registered(value):
   145	                pseudo = object.__new__(cls)
   146	                pseudo._value_ = value
   147	                pseudo._name_ = value.upper().replace("-", "_").replace(" ", "_")
   148	                cls._value2member_map_[value] = pseudo
   149	                cls._member_map_[pseudo._name_] = pseudo
   150	                return pseudo
   151	        except Exception:
   152	            pass
   153	
   154	        return None
   155	
   156	    @classmethod
   157	    def _scan_bundled_plugin_platforms(cls) -> set:
   158	        """Return names of bundled platform plugins under ``plugins/platforms/``."""
   159	        names: set = set()
   160	        try:
   161	            platforms_dir = Path(__file__).parent.parent / "plugins" / "platforms"
   162	            if platforms_dir.is_dir():
   163	                for child in platforms_dir.iterdir():
   164	                    if (
   165	                        child.is_dir()
   166	                        and (child / "__init__.py").exists()
   167	                        and (
   168	                            (child / "plugin.yaml").exists()
   169	                            or (child / "plugin.yml").exists()
   170	                        )
   171	                    ):
   172	                        names.add(child.name.lower())
   173	        except Exception:
   174	            pass
   175	        return names
   176	
   177	
   178	# Snapshot of built-in platform values before any dynamic _missing_ lookups.
   179	# Used to distinguish real platforms from arbitrary strings.
   180	_BUILTIN_PLATFORM_VALUES = frozenset(m.value for m in Platform.__members__.values())
   181	
