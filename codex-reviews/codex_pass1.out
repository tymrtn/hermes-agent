   696	def _is_control_interrupt_message(message: Optional[str]) -> bool:
   697	    """Return True when an interrupt message is internal control flow."""
   698	    if not message:
   699	        return False
   700	    normalized = " ".join(str(message).strip().split()).lower()
   701	    return normalized in _CONTROL_INTERRUPT_MESSAGES
