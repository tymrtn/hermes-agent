   190	def _split_host_port(value: str) -> tuple[str, int | None]:
   191	    raw = str(value or "").strip()
   192	    if not raw:
   193	        return "", None
   194	    if "://" in raw:
   195	        parsed = urlsplit(raw)
   196	        return (parsed.hostname or "").lower().rstrip("."), parsed.port
   197	    if raw.startswith("[") and "]" in raw:
   198	        host, _, rest = raw[1:].partition("]")
   199	        port = None
   200	        if rest.startswith(":") and rest[1:].isdigit():
   201	            port = int(rest[1:])
   202	        return host.lower().rstrip("."), port
   203	    if raw.count(":") == 1:
   204	        host, _, maybe_port = raw.rpartition(":")
   205	        if maybe_port.isdigit():
   206	            return host.lower().rstrip("."), int(maybe_port)
   207	    return raw.lower().strip("[]").rstrip("."), None
