  3212	                    asyncio.gather(
  3213	                        *(asyncio.shield(t) for t in tasks),
  3214	                        return_exceptions=True,
  3215	                    ),
  3216	                    timeout=5.0,
  3217	                )
  3218	            except asyncio.TimeoutError:
  3219	                logger.warning(
  3220	                    "[%s] %d background task(s) did not exit within 5s; "
  3221	                    "releasing tracking and letting them unwind in the background",
  3222	                    self.name, len([t for t in tasks if not t.done()]),
