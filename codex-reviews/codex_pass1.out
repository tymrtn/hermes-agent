  3891	    def _chat_id_for_session(self, session_key: str) -> Optional[str]:
  3892	        """Resolve a Telegram chat_id for a session_key.
  3893	
  3894	        The busy-session APIs receive only ``session_key + message_id`` from
  3895	        the runner; Telegram's edit/delete APIs need the chat_id too.  Pull
  3896	        it from the runner's pending follow-up event (the most recent inbound
  3897	        message in this busy turn) which has it on its ``source``.
  3898	        """
  3899	        runner = getattr(getattr(self, "_message_handler", None), "__self__", None)
  3900	        if runner is None:
  3901	            return None
  3902	        followups = getattr(runner, "_pending_followups", {}) or {}
  3903	        events = followups.get(session_key) or []
  3904	        for event in reversed(events):
  3905	            chat_id = getattr(getattr(event, "source", None), "chat_id", None)
  3906	            if chat_id:
  3907	                return str(chat_id)
  3908	        # Fallback: look up from active running-agents source if exposed.
  3909	        running = getattr(runner, "_running_agents", {}) or {}
  3910	        agent = running.get(session_key)
  3911	        source = getattr(agent, "_session_source", None)
  3912	        if source is not None:
  3913	            chat_id = getattr(source, "chat_id", None)
  3914	            if chat_id:
  3915	                return str(chat_id)
  3916	        return None
