  3918	    async def _handle_busy_session_callback(
  3919	        self,
  3920	        query: Any,
  3921	        data: str,
  3922	        *,
  3923	        chat_id: Optional[Any],
  3924	        chat_type: Optional[Any],
  3925	        thread_id: Optional[Any],
  3926	        user_name: Optional[Any],
  3927	    ) -> None:
  3928	        """Dispatch a ``bs:<primitive>:<session_key>`` button tap."""
  3929	        from gateway.busy_session_buttons import parse_callback_data
  3930	
  3931	        parsed = parse_callback_data(data)
  3932	        if parsed is None:
  3933	            try:
  3934	                await query.answer(text="Invalid button data.")
  3935	            except Exception:
  3936	                pass
  3937	            return
  3938	        primitive, session_key = parsed
  3939	
  3940	        caller_id = str(getattr(query.from_user, "id", ""))
  3941	        if not self._is_callback_user_authorized(
  3942	            caller_id,
  3943	            chat_id=chat_id,
  3944	            chat_type=str(chat_type) if chat_type is not None else None,
  3945	            thread_id=str(thread_id) if thread_id is not None else None,
  3946	            user_name=user_name,
  3947	        ):
  3948	            try:
  3949	                await query.answer(text="⛔ You are not authorized to control this run.")
  3950	            except Exception:
  3951	                pass
  3952	            return
  3953	
  3954	        runner = getattr(getattr(self, "_message_handler", None), "__self__", None)
  3955	        handler = getattr(runner, "_handle_busy_session_button_tap", None)
  3956	        if not callable(handler):
  3957	            try:
  3958	                await query.answer(text="Busy-session controls unavailable.")
  3959	            except Exception:
  3960	                pass
  3961	            return
  3962	
  3963	        # Reconstruct a SessionSource for the dispatch.
  3964	        try:
  3965	            from gateway.session import SessionSource
  3966	
  3967	            normalized_chat_type = str(chat_type or "dm").strip().lower() or "dm"
  3968	            if normalized_chat_type == "private":
  3969	                normalized_chat_type = "dm"
  3970	            elif normalized_chat_type == "supergroup":
  3971	                normalized_chat_type = "forum" if thread_id is not None else "group"
  3972	            source = SessionSource(
  3973	                platform=Platform.TELEGRAM,
  3974	                chat_id=str(chat_id) if chat_id is not None else "",
  3975	                chat_type=normalized_chat_type,
  3976	                user_id=caller_id,
  3977	                user_name=user_name,
  3978	                thread_id=str(thread_id) if thread_id is not None else None,
  3979	            )
  3980	        except Exception as exc:
  3981	            logger.debug("[%s] could not build SessionSource for bs callback: %s", self.name, exc)
  3982	            try:
  3983	                await query.answer(text="Couldn't apply that — try again.")
  3984	            except Exception:
  3985	                pass

