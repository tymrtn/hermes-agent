  1936	    @staticmethod
  1937	    def _load_busy_input_mode() -> str:
  1938	        """Load gateway drain-time busy-input behavior from config/env."""
  1939	        mode = os.getenv("HERMES_GATEWAY_BUSY_INPUT_MODE", "").strip().lower()
  1940	        if not mode:
  1941	            try:
  1942	                import yaml as _y
  1943	                cfg_path = _hermes_home / "config.yaml"
  1944	                if cfg_path.exists():
  1945	                    with open(cfg_path, encoding="utf-8") as _f:
  1946	                        cfg = _y.safe_load(_f) or {}
  1947	                    mode = str(cfg_get(cfg, "display", "busy_input_mode", default="") or "").strip().lower()
  1948	            except Exception:
  1949	                pass
  1950	        if mode == "interrupt":
  1951	            return "interrupt"
  1952	        if mode == "steer":
  1953	            return "steer"
  1954	        return "queue"
