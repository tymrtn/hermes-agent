  4683	    class BusySessionView(discord.ui.View):
  4684	        """Three-button view for per-message busy-session control.
  4685	
  4686	        Lets the user pick steer / interrupt / stop on a specific
  4687	        follow-up message instead of changing the global
  4688	        ``display.busy_input_mode``.  Auth mirrors the other component
  4689	        views via :func:`_component_check_auth`.
  4690	        """
  4691	
  4692	        def __init__(
  4693	            self,
  4694	            session_key: str,
  4695	            adapter_self: "DiscordAdapter",
  4696	            allowed_user_ids: set,
  4697	            allowed_role_ids: Optional[set] = None,
  4698	        ):
  4699	            # No timeout: a busy-session lives as long as the agent is
  4700	            # busy, which is bounded by the agent's own iteration cap.
  4701	            super().__init__(timeout=None)
  4702	            self.session_key = session_key
  4703	            self._adapter = adapter_self
  4704	            self.allowed_user_ids = allowed_user_ids
  4705	            self.allowed_role_ids = allowed_role_ids or set()
  4706	
  4707	        def _check_auth(self, interaction: discord.Interaction) -> bool:
  4708	            return _component_check_auth(
  4709	                interaction, self.allowed_user_ids, self.allowed_role_ids,
  4710	            )
  4711	
  4712	        async def _dispatch(
  4713	            self,
  4714	            interaction: discord.Interaction,
  4715	            primitive: str,
  4716	        ) -> None:
  4717	            if not self._check_auth(interaction):
  4718	                await interaction.response.send_message(
  4719	                    "You're not authorized to control this run~", ephemeral=True,
  4720	                )
  4721	                return
  4722	            await interaction.response.defer(ephemeral=True)
  4723	            try:
  4724	                toast = await self._adapter._handle_busy_session_view_tap(
  4725	                    self.session_key, primitive, interaction,
  4726	                )
  4727	            except Exception as exc:  # pragma: no cover - defensive
  4728	                logger.error(
  4729	                    "[%s] BusySessionView dispatch failed: %s",
  4730	                    self._adapter.name, exc, exc_info=True,
  4731	                )
  4732	                toast = "Couldn't apply that — see logs."
  4733	            try:
  4734	                await interaction.followup.send(toast or "Done.", ephemeral=True)
  4735	            except Exception:
  4736	                pass
  4737	            # Disable buttons after a tap so the same row can't fire twice.
  4738	            for child in self.children:
  4739	                child.disabled = True
  4740	            try:
  4741	                await interaction.message.edit(view=self)
  4742	            except Exception:
  4743	                pass
  4744	
