   956	def coerce_plaintext_gateway_command(event: "MessageEvent") -> None:
   957	    """Rewrite a tiny set of DM plaintext admin phrases into slash commands.
   958	
   959	    This keeps high-impact operational phrases like ``restart gateway`` out of
   960	    the LLM/tool path, where they can trigger a self-restart from inside the
   961	    currently running agent and leave the gateway stuck in ``draining`` while it
   962	    waits for that same agent to finish.
   963	
   964	    Scope is intentionally narrow: DM text messages only, exact restart-style
   965	    phrases only. Group chats keep natural-language semantics.
   966	    """
   967	    try:
   968	        if event is None or event.message_type != MessageType.TEXT:
   969	            return
   970	        text = (event.text or "").strip()
   971	        if not text or text.startswith("/"):
   972	            return
   973	        source = getattr(event, "source", None)
   974	        if getattr(source, "chat_type", None) != "dm":
   975	            return
   976	        for pattern in _PLAINTEXT_GATEWAY_RESTART_PATTERNS:
   977	            if pattern.match(text):
   978	                event.text = "/restart"
   979	                return
   980	    except Exception:
   981	        return
