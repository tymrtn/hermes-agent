  2385	    async def _handle_busy_session_button_tap(
  2386	        self,
  2387	        session_key: str,
  2388	        primitive: str,
  2389	        source: SessionSource,
  2390	    ) -> str:
  2391	        """Apply a busy-session button tap to a session.
  2392	
  2393	        Drains every follow-up that arrived during the current busy
  2394	        turn, joins their texts, and dispatches the selected primitive
  2395	        once.  Emits an acknowledgement reaction on each follow-up.
  2396	        Returns a short status string suitable for a callback toast.
  2397	        """
  2398	        if primitive not in (PRIMITIVE_STEER, PRIMITIVE_INTERRUPT, PRIMITIVE_STOP):
  2399	            return "Unknown action."
  2400	
  2401	        adapter = self.adapters.get(source.platform) if source else None
  2402	        _pf = getattr(self, "_pending_followups", None)
  2403	        followups = _pf.pop(session_key, []) if _pf else []
  2404	        joined_text = "\n\n".join(
  2405	            (e.text or "").strip() for e in followups if (e.text or "").strip()
  2406	        )
  2407	
  2408	        running_agent = self._running_agents.get(session_key)
  2409	        ok = True
  2410	        try:
  2411	            if primitive == PRIMITIVE_STEER:
  2412	                steered = False
  2413	                if (
  2414	                    running_agent
  2415	                    and running_agent is not _AGENT_PENDING_SENTINEL
  2416	                    and hasattr(running_agent, "steer")
  2417	                    and joined_text
  2418	                ):
  2419	                    try:
  2420	                        steered = bool(running_agent.steer(joined_text))
  2421	                    except Exception as exc:
  2422	                        logger.debug("Button-tap steer failed for %s: %s", session_key, exc)
  2423	                if steered:
  2424	                    # The text landed inside the run; remove the queued copy
  2425	                    # so it isn't ALSO replayed as the next-turn prompt.
  2426	                    if adapter is not None and hasattr(adapter, "_pending_messages"):
  2427	                        adapter._pending_messages.pop(session_key, None)
  2428	                else:
  2429	                    ok = False
  2430	
  2431	            elif primitive == PRIMITIVE_INTERRUPT:
  2432	                if running_agent and running_agent is not _AGENT_PENDING_SENTINEL:
  2433	                    try:
  2434	                        running_agent.interrupt(joined_text or None)
  2435	                    except Exception as exc:
  2436	                        logger.debug(
  2437	                            "Button-tap interrupt failed for %s: %s", session_key, exc
  2438	                        )
  2439	                        ok = False
  2440	
  2441	            elif primitive == PRIMITIVE_STOP:
  2442	                # /stop semantics: halt without replay; clear queued slot.
  2443	                try:
  2444	                    await self._interrupt_and_clear_session(
  2445	                        session_key,
  2446	                        source,
  2447	                        interrupt_reason=_INTERRUPT_REASON_STOP,
  2448	                        invalidation_reason="busy-session button: stop",
  2449	                    )
  2450	                except Exception as exc:
  2451	                    logger.debug(
  2452	                        "Button-tap stop failed for %s: %s", session_key, exc
  2453	                    )
  2454	                    ok = False
  2455	        finally:
  2456	            # Emit acknowledgement reactions on every follow-up, even on
  2457	            # failure — the user pressed a button and deserves feedback.
  2458	            if adapter is not None and hasattr(adapter, "set_busy_reaction"):
  2459	                emoji = _busy_button_reaction_for(primitive)
  2460	                if emoji:
  2461	                    for fu in followups:
  2462	                        try:
  2463	                            await adapter.set_busy_reaction(fu, emoji)
  2464	                        except Exception as exc:
  2465	                            logger.debug(
  2466	                                "Busy-session reaction failed for %s: %s",
  2467	                                session_key,
  2468	                                exc,
  2469	                            )
  2470	            await self._clear_busy_session_controls(session_key, source)
  2471	
  2472	        if not ok:
  2473	            return "Couldn't apply that — the run may have already finished."
  2474	        return _busy_button_status_text(primitive)
  2475	
  2476	    async def _clear_busy_session_controls(
  2477	        self,
  2478	        session_key: str,
  2479	        source: Optional[SessionSource],
  2480	    ) -> None:
  2481	        """Tear down keyboard + control bubble + follow-up state for a session.
  2482	
  2483	        Called from the button-tap path, the halt-phrase path, and the
  2484	        end-of-turn cleanup in ``_release_running_agent_state``.  Best-effort.
  2485	        """
  2486	        # Test fixtures that bypass __init__ (e.g. object.__new__(GatewayRunner))
  2487	        # may not have these attributes; guard reads via getattr(...).
  2488	        tool_bubbles = getattr(self, "_tool_bubble_msg_ids", None)
  2489	        control_bubbles = getattr(self, "_busy_control_bubble_ids", None)
  2490	        followups = getattr(self, "_pending_followups", None)
  2491	
  2492	        adapter = None
  2493	        if source is not None:
  2494	            adapter = self.adapters.get(source.platform) if hasattr(self, "adapters") else None
  2495	
  2496	        bubble_id = tool_bubbles.pop(session_key, None) if tool_bubbles else None
  2497	        if bubble_id and adapter is not None and hasattr(adapter, "clear_busy_session_buttons"):
  2498	            try:
  2499	                await adapter.clear_busy_session_buttons(session_key, bubble_id)
  2500	            except Exception as exc:
  2501	                logger.debug(
  2502	                    "clear_busy_session_buttons failed for %s on %s: %s",
  2503	                    session_key,
  2504	                    bubble_id,
  2505	                    exc,
  2506	                )
  2507	
  2508	        control_id = control_bubbles.pop(session_key, None) if control_bubbles else None
  2509	        if control_id and adapter is not None and hasattr(adapter, "delete_busy_control_bubble"):
  2510	            try:
  2511	                await adapter.delete_busy_control_bubble(session_key, control_id)
  2512	            except Exception as exc:
  2513	                logger.debug(
  2514	                    "delete_busy_control_bubble failed for %s on %s: %s",
  2515	                    session_key,
  2516	                    control_id,
  2517	                    exc,
  2518	                )
  2519	
  2520	        if followups is not None:
  2521	            followups.pop(session_key, None)
