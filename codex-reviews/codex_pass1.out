  1134	    def format_message(self, content: str) -> str:
  1135	        """Convert standard markdown to Slack mrkdwn format.
  1136	
  1137	        Protected regions (code blocks, inline code) are extracted first so
  1138	        their contents are never modified.  Standard markdown constructs
  1139	        (headers, bold, italic, links) are translated to mrkdwn syntax.
  1140	        """
  1141	        if not content:
  1142	            return content
  1143	
  1144	        placeholders: dict = {}
  1145	        counter = [0]
  1146	
  1147	        def _ph(value: str) -> str:
  1148	            """Stash value behind a placeholder that survives later passes."""
  1149	            key = f"\x00SL{counter[0]}\x00"
  1150	            counter[0] += 1
  1151	            placeholders[key] = value
  1152	            return key
  1153	
  1154	        text = content
  1155	
  1156	        # 1) Protect fenced code blocks (``` ... ```)
  1157	        text = re.sub(
  1158	            r'(```(?:[^\n]*\n)?[\s\S]*?```)',
  1159	            lambda m: _ph(m.group(0)),
  1160	            text,
  1161	        )
  1162	
  1163	        # 2) Protect inline code (`...`)
  1164	        text = re.sub(r'(`[^`]+`)', lambda m: _ph(m.group(0)), text)
  1165	
  1165	
  1166	        # 3) Convert markdown links [text](url) → <url|text>
  1167	        def _convert_markdown_link(m):
  1168	            label = m.group(1)
  1169	            url = m.group(2).strip()
  1170	            if url.startswith('<') and url.endswith('>'):
  1171	                url = url[1:-1].strip()
  1172	            return _ph(f'<{url}|{label}>')
  1173	
  1174	        text = re.sub(
  1175	            r'(?<!!)\[([^\]]+)\]\(([^()]*(?:\([^()]*\)[^()]*)*)\)',
  1176	            _convert_markdown_link,
  1177	            text,
  1178	        )
  1179	
  1180	        # 4) Protect existing Slack entities/manual links so escaping and later
  1181	        #    formatting passes don't break them.
  1182	        text = re.sub(
  1183	            r'(<(?:[@#!]|(?:https?|mailto|tel):)[^>\n]+>)',
  1184	            lambda m: _ph(m.group(1)),
  1185	            text,
  1186	        )
  1187	
  1188	        # 5) Protect blockquote markers before escaping
  1189	        text = re.sub(r'^(>+\s)', lambda m: _ph(m.group(0)), text, flags=re.MULTILINE)
  1190	
  1191	        # 6) Escape Slack control characters in remaining plain text.
  1192	        # Unescape first so already-escaped input doesn't get double-escaped.
  1193	        text = text.replace('&amp;', '&').replace('&lt;', '<').replace('&gt;', '>')
  1194	        text = text.replace('&', '&amp;').replace('<', '&lt;').replace('>', '&gt;')
  1195	
  1196	        # 7) Convert headers (## Title) → *Title* (bold)
  1197	        def _convert_header(m):
  1198	            inner = m.group(1).strip()
  1199	            # Strip redundant bold markers inside a header
  1200	            inner = re.sub(r'\*\*(.+?)\*\*', r'\1', inner)
  1201	            return _ph(f'*{inner}*')
  1202	
  1203	        text = re.sub(
  1204	            r'^#{1,6}\s+(.+)$', _convert_header, text, flags=re.MULTILINE
  1205	        )
  1206	
  1207	        # 8) Convert bold+italic: ***text*** → *_text_* (Slack bold wrapping italic)
  1208	        text = re.sub(
  1209	            r'\*\*\*(.+?)\*\*\*',
  1210	            lambda m: _ph(f'*_{m.group(1)}_*'),
  1211	            text,
  1212	        )
  1213	
  1214	        # 9) Convert bold: **text** → *text* (Slack bold)
  1215	        text = re.sub(
  1216	            r'\*\*(.+?)\*\*',
  1217	            lambda m: _ph(f'*{m.group(1)}*'),
  1218	            text,
  1219	        )
  1220	
  1221	        # 10) Convert italic: _text_ stays as _text_ (already Slack italic)
  1222	        #     Single *text* → _text_ (Slack italic), but only when the
  1223	        #     emphasized text touches non-whitespace on both sides so literal
