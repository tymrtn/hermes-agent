   919	def _format_gateway_process_notification(evt: dict) -> "str | None":
   920	    """Format a watch pattern event from completion_queue into a [IMPORTANT:] message."""
   921	    evt_type = evt.get("type", "completion")
   922	    _sid = evt.get("session_id", "unknown")
   923	    _cmd = evt.get("command", "unknown")
   924	
   925	    if evt_type == "watch_disabled":
   926	        return f"[IMPORTANT: {evt.get('message', '')}]"
   927	
   928	    if evt_type == "watch_match":
   929	        _pat = evt.get("pattern", "?")
   930	        _out = evt.get("output", "")
   931	        _sup = evt.get("suppressed", 0)
   932	        text = (
   933	            f"[IMPORTANT: Background process {_sid} matched "
   934	            f"watch pattern \"{_pat}\".\n"
   935	            f"Command: {_cmd}\n"
   936	            f"Matched output:\n{_out}"
   937	        )
   938	        if _sup:
   939	            text += f"\n({_sup} earlier matches were suppressed by rate limit)"
   940	        text += "]"
   941	        return text
   942	
   943	    return None
