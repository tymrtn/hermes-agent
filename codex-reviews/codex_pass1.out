 11491	    def _begin_session_run_generation(self, session_key: str) -> int:
 11492	        """Claim a fresh run generation token for ``session_key``.
 11493	
 11494	        Every top-level gateway turn gets a monotonically increasing token.
 11495	        If a later command like /stop or /new invalidates that token while the
 11496	        old worker is still unwinding, the late result can be recognized and
 11497	        dropped instead of bleeding into the fresh session.
 11498	        """
