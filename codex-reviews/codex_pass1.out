  1956	    @staticmethod
  1957	    def _load_restart_drain_timeout() -> float:
  1958	        """Load graceful gateway restart/stop drain timeout in seconds."""
  1959	        raw = os.getenv("HERMES_RESTART_DRAIN_TIMEOUT", "").strip()
  1960	        if not raw:
  1961	            try:
  1962	                import yaml as _y
  1963	                cfg_path = _hermes_home / "config.yaml"
  1964	                if cfg_path.exists():
