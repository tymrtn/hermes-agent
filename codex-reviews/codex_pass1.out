  2052	    def _snapshot_running_agents(self) -> Dict[str, Any]:
  2053	        return {
  2054	            session_key: agent
  2055	            for session_key, agent in self._running_agents.items()
  2056	            if agent is not _AGENT_PENDING_SENTINEL
