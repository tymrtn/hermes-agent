  3857	    async def set_busy_reaction(self, event: MessageEvent, emoji: str) -> bool:
  3858	        """Emit a busy-session acknowledgement reaction on ``event``.
  3859	
  3860	        Uses ``ReactionTypeEmoji`` explicitly to avoid python-telegram-bot's
  3861	        variation-selector serialization bug — bare emoji strings with VS-16
  3862	        (e.g. ⚡️) are otherwise mis-routed as ``custom_emoji_id`` and rejected.
  3863	        """
  3864	        if not self._bot or not emoji:
  3865	            return False
  3866	        chat_id = getattr(event.source, "chat_id", None) if event and event.source else None
  3867	        message_id = getattr(event, "message_id", None) if event else None
  3868	        if not chat_id or not message_id:
  3869	            return False
  3870	        try:
  3871	            from telegram import ReactionTypeEmoji  # type: ignore
  3872	            reaction = [ReactionTypeEmoji(emoji=emoji)]
  3873	        except Exception:
  3874	            reaction = emoji  # fallback — older telegram lib
  3875	        try:
  3876	            await self._bot.set_message_reaction(
  3877	                chat_id=int(chat_id),
  3878	                message_id=int(message_id),
  3879	                reaction=reaction,
  3880	            )
  3881	            return True
  3882	        except Exception as exc:
  3883	            logger.debug(
  3884	                "[%s] set_busy_reaction(%s) failed: %s",
  3885	                self.name,
  3886	                emoji,
  3887	                exc,
  3888	            )
  3889	            return False
