  2995	    def _resolve_busy_channel_id(self, session_key: str) -> Optional[str]:
  2996	        """Resolve a Slack channel id for ``session_key`` from runner state."""
  2997	        runner = getattr(getattr(self, "_message_handler", None), "__self__", None)
  2998	        if runner is None:
  2999	            return None
  3000	        followups = getattr(runner, "_pending_followups", {}) or {}
  3001	        for ev in reversed(followups.get(session_key) or []):
