   812	    cache_dir = get_document_cache_dir()
   813	    # Sanitize: strip directory components, null bytes, and control characters
   814	    safe_name = Path(filename).name if filename else "document"
   815	    safe_name = safe_name.replace("\x00", "").strip()
   816	    if not safe_name or safe_name in (".", ".."):
   817	        safe_name = "document"
   818	    cached_name = f"doc_{uuid.uuid4().hex[:12]}_{safe_name}"
   819	    filepath = cache_dir / cached_name
   820	    # Final safety check: ensure path stays inside cache dir

