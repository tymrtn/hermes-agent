  2065	    async def _handle_active_session_busy_message(self, event: MessageEvent, session_key: str) -> bool:
  2066	        # --- Authorization gate (#17775) ---
  2067	        # The cold path (_handle_message) checks _is_user_authorized before
  2068	        # creating a session.  The busy path must enforce the same check;
  2069	        # otherwise unauthorized users in shared threads (Slack/Telegram/Discord)
  2070	        # can inject messages into an active session they don't own.
  2071	        if not self._is_user_authorized(event.source):
  2072	            logger.warning(
  2073	                "Dropping message from unauthorized user in active session: "
  2074	                "user=%s (%s), platform=%s, session=%s",
  2075	                event.source.user_id,
  2076	                event.source.user_name,
  2077	                event.source.platform.value if event.source.platform else "unknown",
  2078	                session_key,
  2079	            )
  2080	            return True  # handled (silently dropped); do not fall through
  2081	
  2082	        # --- Multilingual halt-phrase pre-flight ---
  2083	        # A short message that matches a literal stop intent (English "stop",
  2084	        # Spanish "alto", Japanese "止まれ", lone "/", empty msg, etc.) halts
  2085	        # the running agent immediately, no matter what busy_input_mode is
  2086	        # configured.  This is the language-neutral equivalent of /stop —
  2087	        # users on phones rarely remember the slash command.
  2088	        msg_type = getattr(event, "message_type", None)
  2089	        if msg_type is None or msg_type == MessageType.TEXT or event.text:
  2090	            halt_lang = matches_stop_phrase(event.text)
  2091	            if halt_lang is not None:
  2092	                if await self._handle_halt_phrase_match(event, session_key, halt_lang):
  2093	                    return True
  2094	
  2095	        # --- Draining case (gateway restarting/stopping) ---
  2096	        if self._draining:
  2097	            adapter = self.adapters.get(event.source.platform)
  2098	            if not adapter:
  2099	                return True
  2100	
  2101	            thread_meta = {"thread_id": event.source.thread_id} if event.source.thread_id else None
  2102	            if self._queue_during_drain_enabled():
  2103	                self._queue_or_replace_pending_event(session_key, event)
  2104	                message = f"⏳ Gateway {self._status_action_gerund()} — queued for the next turn after it comes back."
  2105	            else:
  2106	                message = f"⏳ Gateway is {self._status_action_gerund()} and is not accepting another turn right now."
  2107	
  2108	            await adapter._send_with_retry(
  2109	                chat_id=event.source.chat_id,
  2110	                content=message,
  2111	                reply_to=event.message_id,
  2112	                metadata=thread_meta,
  2113	            )
  2114	            return True
  2115	
  2116	        # Normal busy case (agent actively running a task)
  2117	        adapter = self.adapters.get(event.source.platform)
  2118	        if not adapter:
  2119	            return False  # let default path handle it
  2120	
  2121	        running_agent = self._running_agents.get(session_key)
  2122	
  2123	        # Steer mode: inject mid-run via running_agent.steer() instead of
  2124	        # queueing + interrupting.  If the agent isn't running yet
  2125	        # (sentinel) or lacks steer(), or the payload is empty, fall back
  2126	        # to queue semantics so nothing is lost.
  2127	        effective_mode = self._busy_input_mode
  2128	        steered = False
  2129	        if effective_mode == "steer":
  2130	            steer_text = (event.text or "").strip()
  2131	            can_steer = (
  2132	                steer_text
  2133	                and running_agent is not None
  2134	                and running_agent is not _AGENT_PENDING_SENTINEL
  2135	                and hasattr(running_agent, "steer")
  2136	            )
  2137	            if can_steer:
  2138	                try:
  2139	                    steered = bool(running_agent.steer(steer_text))
  2140	                except Exception as exc:
  2141	                    logger.warning("Gateway steer failed for session %s: %s", session_key, exc)
  2142	                    steered = False
  2143	            if not steered:
  2144	                # Fall back to queue (merge into pending messages, no interrupt)
  2145	                effective_mode = "queue"
  2146	
  2147	        # Store the message so it's processed as the next turn after the
  2148	        # current run finishes (or is interrupted).  Skip this for a
  2149	        # successful steer — the text already landed inside the run and
  2150	        # must NOT also be replayed as a next-turn user message.
  2151	        if not steered:
  2152	            merge_pending_message_event(adapter._pending_messages, session_key, event)
  2153	
  2154	        is_queue_mode = effective_mode == "queue"
  2155	        is_steer_mode = effective_mode == "steer"
  2156	
  2157	        # If not in queue/steer mode, interrupt the running agent immediately.
  2158	        # This aborts in-flight tool calls and causes the agent loop to exit
  2159	        # at the next check point.
  2160	        if effective_mode == "interrupt" and running_agent and running_agent is not _AGENT_PENDING_SENTINEL:
  2161	            try:
  2162	                running_agent.interrupt(event.text)
  2163	            except Exception:
  2164	                pass  # don't let interrupt failure block the ack
  2165	
  2166	        # Track this follow-up for the button-tap path (a tap acts on every
  2167	        # follow-up that arrived during the current busy turn) and ensure
  2168	        # the [/steer][/interrupt][/stop] keyboard is attached to the
  2169	        # active tool bubble — or a standalone control bubble if no tool
  2170	        # has fired yet.  Best-effort: failures are logged and don't block
  2171	        # the busy ack.
  2172	        try:
  2173	            _pf = getattr(self, "_pending_followups", None)
  2174	            if _pf is not None:
  2175	                _pf.setdefault(session_key, []).append(event)
  2176	            await self._ensure_busy_session_controls(session_key, event)
  2177	        except Exception as _bs_err:
  2178	            logger.debug("Busy-session control attach failed for %s: %s", session_key, _bs_err)
  2179	
  2180	        # Check if busy ack is disabled — skip sending but still process the input.
  2181	        # Placed before debounce so we don't stamp a "last ack" timestamp that was
  2182	        # never actually delivered.
  2183	        busy_ack_enabled = os.environ.get("HERMES_GATEWAY_BUSY_ACK_ENABLED", "true").lower() == "true"
  2184	        if not busy_ack_enabled:
  2185	            logger.debug("Busy ack suppressed for session %s", session_key)
  2186	            return True  # input still processed, just no ack sent
  2187	
  2188	        # Debounce: only send an acknowledgment once every 30 seconds per session
  2189	        # to avoid spamming the user when they send multiple messages quickly
  2190	        _BUSY_ACK_COOLDOWN = 30
  2191	        now = time.time()
  2192	        last_ack = self._busy_ack_ts.get(session_key, 0)
  2193	        if now - last_ack < _BUSY_ACK_COOLDOWN:
  2194	            return True  # interrupt sent (if not queue), ack already delivered recently
  2195	
  2196	        self._busy_ack_ts[session_key] = now
  2197	
  2198	        # Build a status-rich acknowledgment
  2199	        status_parts = []
  2200	        if running_agent and running_agent is not _AGENT_PENDING_SENTINEL:
  2201	            try:
  2202	                summary = running_agent.get_activity_summary()
  2203	                iteration = summary.get("api_call_count", 0)
  2204	                max_iter = summary.get("max_iterations", 0)
  2205	                current_tool = summary.get("current_tool")
  2206	                start_ts = self._running_agents_ts.get(session_key, 0)
  2207	                if start_ts:
  2208	                    elapsed_min = int((now - start_ts) / 60)
  2209	                    if elapsed_min > 0:
  2210	                        status_parts.append(f"{elapsed_min} min elapsed")
  2211	                if max_iter:
  2212	                    status_parts.append(f"iteration {iteration}/{max_iter}")
  2213	                if current_tool:
  2214	                    status_parts.append(f"running: {current_tool}")
  2215	            except Exception:
  2216	                pass
  2217	
  2218	        status_detail = f" ({', '.join(status_parts)})" if status_parts else ""
  2219	        if is_steer_mode:
  2220	            message = (
  2221	                f"⏩ Steered into current run{status_detail}. "
  2222	                f"Your message arrives after the next tool call."
  2223	            )
  2224	        elif is_queue_mode:
  2225	            message = (
  2226	                f"⏳ Queued for the next turn{status_detail}. "
  2227	                f"I'll respond once the current task finishes."
  2228	            )
  2229	        else:
  2230	            message = (
  2231	                f"⚡ Interrupting current task{status_detail}. "
  2232	                f"I'll respond to your message shortly."
  2233	            )
  2234	
  2235	        # First-touch onboarding: the very first time a user sends a message
  2236	        # while the agent is busy, append a one-time hint explaining the
  2237	        # queue/interrupt knob.  Flag is persisted to config.yaml so it never
  2238	        # fires again on this install.
  2239	        try:
  2240	            from agent.onboarding import (
  2241	                BUSY_INPUT_FLAG,
  2242	                busy_input_hint_gateway,
  2243	                is_seen,
  2244	                mark_seen,
  2245	            )
  2246	            _user_cfg = _load_gateway_config()
  2247	            if not is_seen(_user_cfg, BUSY_INPUT_FLAG):
  2248	                if is_steer_mode:
  2249	                    _hint_mode = "steer"
  2250	                elif is_queue_mode:
  2251	                    _hint_mode = "queue"
  2252	                else:
  2253	                    _hint_mode = "interrupt"
  2254	                message = (
  2255	                    f"{message}\n\n"
  2256	                    f"{busy_input_hint_gateway(_hint_mode)}"
  2257	                )
  2258	                mark_seen(_hermes_home / "config.yaml", BUSY_INPUT_FLAG)
  2259	        except Exception as _onb_err:
  2260	            logger.debug("Failed to apply busy-input onboarding hint: %s", _onb_err)
  2261	
  2262	        thread_meta = {"thread_id": event.source.thread_id} if event.source.thread_id else None
  2263	        try:
  2264	            await adapter._send_with_retry(
  2265	                chat_id=event.source.chat_id,
  2266	                content=message,
  2267	                reply_to=event.message_id,
  2268	                metadata=thread_meta,
  2269	            )
  2270	        except Exception as e:
  2271	            logger.debug("Failed to send busy-ack: %s", e)
  2272	
  2273	        return True
