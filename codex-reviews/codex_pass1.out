 11500	            return 0
 11501	        generations = self.__dict__.get("_session_run_generation")
 11502	        if generations is None:
 11503	            generations = {}
 11504	            self._session_run_generation = generations
 11505	        next_generation = int(generations.get(session_key, 0)) + 1
 11506	        generations[session_key] = next_generation
 11507	        return next_generation
