  3007	    async def attach_busy_session_buttons(
  3008	        self,
  3009	        session_key: str,
  3010	        message_id: str,
  3011	    ) -> bool:
  3012	        """Attach the busy-session block to ``message_id`` (Slack ts).
  3013	
  3014	        ``message_id`` IS the Slack message ts.  The runner pairs it with
  3015	        a channel id resolved from the most-recent follow-up's source.
  3016	        """
  3017	        if not self._busy_buttons_enabled() or not self._app:
  3018	            return False
  3019	        channel_id = self._resolve_busy_channel_id(session_key)
  3020	        if not channel_id:
  3021	            return False
  3022	        # Use a minimal "Working…" summary so we don't overwrite any
  3023	        # existing content text (Slack's chat_update overwrites the
  3024	        # entire message).  The progress-bubble update path is the
  3025	        # source of truth for the body text; here we only modify blocks.
  3026	        # Practical caveat: chat_update with `blocks` REPLACES blocks
  3027	        # entirely.  In the tool-bubble path, the bubble's text already
  3028	        # carries the running tool log, so the runner re-renders the
  3029	        # full bubble (incl. blocks) every edit — no surgery needed
  3030	        # here for the keyboard to persist across edits.
  3031	        try:
  3032	            client = self._get_client(channel_id)
  3033	            existing = self._busy_session_button_map.get(session_key)
  3034	            if existing == (channel_id, message_id):
  3035	                return True
  3036	            self._busy_session_button_map[session_key] = (channel_id, message_id)
  3037	            return True
  3038	        except Exception as exc:
  3039	            logger.debug(
  3040	                "[%s] attach_busy_session_buttons setup failed for %s: %s",
  3041	                self.name, session_key, exc,
  3042	            )
  3043	            return False
  3044	
  3045	    async def clear_busy_session_buttons(
  3046	        self,
  3047	        session_key: str,
  3048	        message_id: str,
  3049	    ) -> bool:
  3050	        """Drop the busy-session block from ``message_id``.
  3051	
  3052	        Implemented by re-rendering the bubble with a no-actions block list.
  3053	        Best-effort.
  3054	        """
  3055	        coords = self._busy_session_button_map.pop(session_key, None)
  3056	        if not coords or not self._app:
  3057	            return False
  3058	        channel_id, ts = coords
  3059	        try:
  3060	            await self._get_client(channel_id).chat_update(
  3061	                channel=channel_id,
  3062	                ts=ts,
  3063	                blocks=[],
  3064	                text="",
  3065	            )
  3066	            return True
  3067	        except Exception as exc:
  3068	            logger.debug(
  3069	                "[%s] clear_busy_session_buttons failed for %s: %s",
  3070	                self.name, session_key, exc,
