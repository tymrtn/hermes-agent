  4784	    async def attach_busy_session_buttons(
  4785	        self,
  4786	        session_key: str,
  4787	        message_id: str,
  4788	    ) -> bool:
  4789	        if not self._busy_buttons_enabled() or not self._client:
  4790	            return False
  4791	        chat_id = self._chat_id_for_session(session_key)
  4792	        if not chat_id:
  4793	            return False
  4794	        try:
  4795	            channel = self._client.get_channel(int(chat_id))
  4796	            if not channel:
  4797	                channel = await self._client.fetch_channel(int(chat_id))
  4798	            msg = await channel.fetch_message(int(message_id))
  4799	            view = self.BusySessionView(
  4800	                session_key=session_key,
  4801	                adapter_self=self,
  4802	                allowed_user_ids=self._allowed_user_ids,
  4803	                allowed_role_ids=self._allowed_role_ids,
  4804	            )
  4805	            await msg.edit(view=view)
  4806	            self._busy_session_view_map[session_key] = str(message_id)
  4807	            return True
  4808	        except Exception as exc:
  4809	            logger.debug(
  4810	                "[%s] attach_busy_session_buttons failed for %s on %s: %s",
  4811	                self.name, session_key, message_id, exc,
  4812	            )
  4813	            return False
  4814	
  4815	    async def clear_busy_session_buttons(
  4816	        self,
  4817	        session_key: str,
  4818	        message_id: str,
  4819	    ) -> bool:
  4820	        self._busy_session_view_map.pop(session_key, None)
  4821	        if not self._client:
  4822	            return False
  4823	        chat_id = self._chat_id_for_session(session_key)
  4824	        if not chat_id:
  4825	            return False
  4826	        try:
  4827	            channel = self._client.get_channel(int(chat_id))
  4828	            if not channel:
  4829	                channel = await self._client.fetch_channel(int(chat_id))
  4830	            msg = await channel.fetch_message(int(message_id))
  4831	            await msg.edit(view=None)
  4832	            return True
  4833	        except Exception as exc:
  4834	            logger.debug(
  4835	                "[%s] clear_busy_session_buttons failed for %s on %s: %s",
  4836	                self.name, session_key, message_id, exc,
  4837	            )
  4838	            return False
