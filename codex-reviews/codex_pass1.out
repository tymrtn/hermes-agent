  4773	    def _chat_id_for_session(self, session_key: str) -> Optional[str]:
  4774	        runner = getattr(getattr(self, "_message_handler", None), "__self__", None)
  4775	        if runner is None:
  4776	            return None
  4777	        followups = getattr(runner, "_pending_followups", {}) or {}
  4778	        for ev in reversed(followups.get(session_key) or []):
  4779	            chat_id = getattr(getattr(ev, "source", None), "chat_id", None)
  4780	            if chat_id:
  4781	                return str(chat_id)
  4782	        return None
