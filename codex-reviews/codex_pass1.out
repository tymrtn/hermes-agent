   526	def cache_image_from_bytes(data: bytes, ext: str = ".jpg") -> str:
   527	    """
   528	    Save raw image bytes to the cache and return the absolute file path.
   529	
   530	    Args:
   531	        data: Raw image bytes.
   532	        ext:  File extension including the dot (e.g. ".jpg", ".png").
   533	
   534	    Returns:
   535	        Absolute path to the cached image file as a string.
   536	
   537	    Raises:
   538	        ValueError: If *data* does not look like a valid image (e.g. an HTML
   539	            error page returned by the upstream server).
   540	    """
   541	    if not _looks_like_image(data):
   542	        snippet = data[:80].decode("utf-8", errors="replace")
   543	        raise ValueError(
   544	            f"Refusing to cache non-image data as {ext} "
   545	            f"(starts with: {snippet!r})"
   546	        )
   547	    cache_dir = get_image_cache_dir()
   548	    filename = f"img_{uuid.uuid4().hex[:12]}{ext}"
   549	    filepath = cache_dir / filename
   550	    filepath.write_bytes(data)
   551	    return str(filepath)
   552	
   553	
   554	async def cache_image_from_url(url: str, ext: str = ".jpg", retries: int = 2) -> str:
   555	    """
   556	    Download an image from a URL and save it to the local cache.
   557	
   558	    Retries on transient failures (timeouts, 429, 5xx) with exponential
   559	    backoff so a single slow CDN response doesn't lose the media.
   560	
   561	    Args:
   562	        url: The HTTP/HTTPS URL to download from.
   563	        ext: File extension including the dot (e.g. ".jpg", ".png").
   564	        retries: Number of retry attempts on transient failures.
   565	
   566	    Returns:
   567	        Absolute path to the cached image file as a string.
   568	
   569	    Raises:
   570	        ValueError: If the URL targets a private/internal network (SSRF protection).
   571	    """
   572	    from tools.url_safety import is_safe_url
   573	    if not is_safe_url(url):
   574	        raise ValueError(f"Blocked unsafe URL (SSRF protection): {safe_url_for_log(url)}")
   575	
   576	    import httpx
   577	    _log = logging.getLogger(__name__)
   578	
   579	    async with httpx.AsyncClient(
   580	        timeout=30.0,
   581	        follow_redirects=True,
   582	        event_hooks={"response": [_ssrf_redirect_guard]},
   583	    ) as client:
   584	        for attempt in range(retries + 1):
   585	            try:
   586	                response = await client.get(
   587	                    url,
   588	                    headers={
   589	                        "User-Agent": "Mozilla/5.0 (compatible; HermesAgent/1.0)",
   590	                        "Accept": "image/*,*/*;q=0.8",
   591	                    },
   592	                )
   593	                response.raise_for_status()
   594	                return cache_image_from_bytes(response.content, ext)
   595	            except (httpx.TimeoutException, httpx.HTTPStatusError) as exc:
   596	                if isinstance(exc, httpx.HTTPStatusError) and exc.response.status_code < 429:
   597	                    raise
   598	                if attempt < retries:
   599	                    wait = 1.5 * (attempt + 1)
   600	                    _log.debug(
   601	                        "Media cache retry %d/%d for %s (%.1fs): %s",
   602	                        attempt + 1,
   603	                        retries,
   604	                        safe_url_for_log(url),
   605	                        wait,
   606	                        exc,
   607	                    )
   608	                    await asyncio.sleep(wait)
   609	                    continue
   610	                raise
   611	
   612	
   613	def cleanup_image_cache(max_age_hours: int = 24) -> int:
   614	    """
   615	    Delete cached images older than *max_age_hours*.
   616	
   617	    Returns the number of files removed.
   618	    """
   619	    import time
   620	
   621	    cache_dir = get_image_cache_dir()
   622	    cutoff = time.time() - (max_age_hours * 3600)
   623	    removed = 0
   624	    for f in cache_dir.iterdir():
   625	        if f.is_file() and f.stat().st_mtime < cutoff:
   626	            try:
   627	                f.unlink()
   628	                removed += 1
   629	            except OSError:
   630	                pass
   631	    return removed
   632	
