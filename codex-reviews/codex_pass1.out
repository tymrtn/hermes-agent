  4862	            session_key=session_key,
  4863	            adapter_self=self,
  4864	            allowed_user_ids=self._allowed_user_ids,
  4865	            allowed_role_ids=self._allowed_role_ids,
  4866	        )
  4867	        existing = self._busy_control_bubble_ids.get(session_key)
  4868	        if existing:
  4869	            try:
  4870	                msg = await channel.fetch_message(int(existing))
  4871	                await msg.edit(content=summary_text, view=view)
  4872	                self._busy_session_view_map[session_key] = existing
