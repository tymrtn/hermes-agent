  2278	
  2279	    async def _handle_halt_phrase_match(
  2280	        self,
  2281	        event: MessageEvent,
  2282	        session_key: str,
  2283	        lang: str,
  2284	    ) -> bool:
  2285	        """Halt the running agent in response to a literal stop intent.
  2286	
  2287	        Triggered from the busy handler when ``matches_stop_phrase()``
  2288	        returns non-None.  Bypasses the configured ``busy_input_mode`` —
  2289	        a stop intent is unconditional.
  2290	        """
  2291	        running_agent = self._running_agents.get(session_key)
  2292	        adapter = self.adapters.get(event.source.platform) if event.source else None
  2293	
  2294	        # Halt without replay: pass no message to interrupt() so the
  2295	        # event is NOT promoted as a next-turn prompt.
  2296	        try:
  2297	            if running_agent and running_agent is not _AGENT_PENDING_SENTINEL:
  2298	                running_agent.interrupt(None)
  2299	        except Exception as exc:
  2300	            logger.debug("Halt-phrase interrupt failed for %s: %s", session_key, exc)
  2301	
  2302	        # Clear any queued follow-ups; the user signalled stop, not redirect.
  2303	        self._pending_followups.pop(session_key, None)
  2304	        if adapter is not None and hasattr(adapter, "_pending_messages"):
  2305	            adapter._pending_messages.pop(session_key, None)
  2306	
  2307	        # Acknowledge with the stop reaction directly on the user's message.
  2308	        if adapter is not None and hasattr(adapter, "set_busy_reaction"):
  2309	            try:
  2310	                await adapter.set_busy_reaction(event, REACTION_STOP)
  2311	            except Exception as exc:
  2312	                logger.debug("Halt-phrase reaction failed for %s: %s", session_key, exc)
  2313	
  2314	        # Tear down any control surfaces that may have been attached
  2315	        # before the halt intent arrived.
  2316	        await self._clear_busy_session_controls(session_key, event.source)
  2317	
  2318	        logger.info(
  2319	            "Busy-session halt-phrase matched (lang=%s) for session %s",
  2320	            lang,
  2321	            session_key,
  2322	        )
  2323	        return True
  2324	
  2325	    async def _ensure_busy_session_controls(
  2325	    async def _ensure_busy_session_controls(
  2326	        self,
  2327	        session_key: str,
  2328	        event: MessageEvent,
  2329	    ) -> None:
  2330	        """Attach the [/steer][/interrupt][/stop] keyboard for the session.
  2331	
  2332	        Prefers anchoring to the current tool-progress bubble (so the
  2333	        controls live alongside the live tool log).  Falls back to a
  2334	        standalone control bubble when no tool has fired yet, or the
  2335	        most recent assistant turn was a streaming response with no tools.
  2336	        """
  2337	        adapter = self.adapters.get(event.source.platform) if event.source else None
  2338	        if adapter is None:
  2339	            return
  2340	
  2341	        _tbm = getattr(self, "_tool_bubble_msg_ids", None)
  2342	        bubble_id = _tbm.get(session_key) if _tbm else None
  2343	        if bubble_id and hasattr(adapter, "attach_busy_session_buttons"):
  2344	            try:
  2345	                await adapter.attach_busy_session_buttons(session_key, bubble_id)
  2346	                return
  2347	            except Exception as exc:
  2348	                logger.debug(
  2349	                    "attach_busy_session_buttons failed for %s on %s: %s",
  2350	                    session_key,
  2351	                    bubble_id,
  2352	                    exc,
  2353	                )
  2354	
  2355	        # Fallback: standalone control bubble.
  2356	        if hasattr(adapter, "send_or_update_busy_control_bubble"):
  2357	            try:
  2358	                summary = self._busy_control_bubble_summary(session_key)
  2359	                control_id = await adapter.send_or_update_busy_control_bubble(
  2360	                    session_key,
  2361	                    event.source,
  2362	                    summary,
  2363	                )
  2364	                if control_id:
  2365	                    _bcb = getattr(self, "_busy_control_bubble_ids", None)
  2366	                    if _bcb is not None:
  2367	                        _bcb[session_key] = control_id
  2368	            except Exception as exc:
  2369	                logger.debug(
  2370	                    "send_or_update_busy_control_bubble failed for %s: %s",
  2371	                    session_key,
  2372	                    exc,
  2373	                )
  2374	
  2375	    def _busy_control_bubble_summary(self, session_key: str) -> str:
  2376	        """Return the body text for the standalone control bubble."""
  2377	        _pf = getattr(self, "_pending_followups", None)
  2378	        n = len(_pf.get(session_key, [])) if _pf else 0
  2379	        if n <= 1:
  2380	            base = "Working on the previous message…"
  2381	        else:
  2382	            base = f"Working on the previous message — {n} follow-ups queued."
  2383	        return f"{base}\n\nUse the buttons below to steer, interrupt, or stop."
  2384	
  2385	    async def _handle_busy_session_button_tap(
  2386	        self,
  2387	        session_key: str,
  2388	        primitive: str,
  2389	        source: SessionSource,
  2390	    ) -> str:
  2391	        """Apply a busy-session button tap to a session.
  2392	
  2393	        Drains every follow-up that arrived during the current busy
  2394	        turn, joins their texts, and dispatches the selected primitive
  2395	        once.  Emits an acknowledgement reaction on each follow-up.
  2396	        Returns a short status string suitable for a callback toast.
  2397	        """
  2398	        if primitive not in (PRIMITIVE_STEER, PRIMITIVE_INTERRUPT, PRIMITIVE_STOP):
  2399	            return "Unknown action."
  2400	
  2401	        adapter = self.adapters.get(source.platform) if source else None
  2402	        _pf = getattr(self, "_pending_followups", None)
  2403	        followups = _pf.pop(session_key, []) if _pf else []
  2404	        joined_text = "\n\n".join(
  2405	            (e.text or "").strip() for e in followups if (e.text or "").strip()
  2406	        )
  2407	
  2408	        running_agent = self._running_agents.get(session_key)
  2409	        ok = True
  2410	        try:
  2411	            if primitive == PRIMITIVE_STEER:
  2412	                steered = False
  2413	                if (
  2414	                    running_agent
  2415	                    and running_agent is not _AGENT_PENDING_SENTINEL
  2416	                    and hasattr(running_agent, "steer")
  2417	                    and joined_text
  2418	                ):
