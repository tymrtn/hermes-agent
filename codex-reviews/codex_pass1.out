  1982	    @staticmethod
  1983	    def _load_background_notifications_mode() -> str:
  1984	        """Load background process notification mode from config or env var.
  1985	
  1986	        Modes:
  1987	          - ``all``    — push running-output updates *and* the final message (default)
  1988	          - ``result`` — only the final completion message (regardless of exit code)
  1989	          - ``error``  — only the final message when exit code is non-zero
  1990	          - ``off``    — no watcher messages at all
  1991	        """
  1992	        mode = os.getenv("HERMES_BACKGROUND_NOTIFICATIONS", "")
  1993	        if not mode:
  1994	            try:
  1995	                import yaml as _y
  1996	                cfg_path = _hermes_home / "config.yaml"
  1997	                if cfg_path.exists():
  1998	                    with open(cfg_path, encoding="utf-8") as _f:
  1999	                        cfg = _y.safe_load(_f) or {}
  2000	                    raw = cfg_get(cfg, "display", "background_process_notifications")
  2001	                    if raw is False:
  2002	                        mode = "off"
  2003	                    elif raw not in (None, ""):
  2004	                        mode = str(raw)
  2005	            except Exception:
  2006	                pass
  2007	        mode = (mode or "all").strip().lower()
  2008	        valid = {"all", "result", "error", "off"}
  2009	        if mode not in valid:
  2010	            logger.warning(
  2011	                "Unknown background_process_notifications '%s', defaulting to 'all'",
  2012	                mode,
  2013	            )
  2014	            return "all"
  2015	        return mode
