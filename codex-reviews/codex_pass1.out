  4100	def _component_check_auth(
  4101	    interaction,
  4102	    allowed_user_ids: Optional[set],
  4103	    allowed_role_ids: Optional[set],
  4104	) -> bool:
  4105	    """Shared user-or-role OR semantics for component view button clicks.
  4106	
  4107	    Mirrors ``DiscordAdapter._is_allowed_user`` / the slash and on_message
  4108	    gates so every Discord interaction surface honors the same trust
  4109	    boundary. Component views (ExecApprovalView, SlashConfirmView,
  4110	    UpdatePromptView, ModelPickerView) used to receive only
  4111	    ``allowed_user_ids``: in role-only deployments
  4112	    (DISCORD_ALLOWED_ROLES set, DISCORD_ALLOWED_USERS empty) the user
  4113	    set was empty and the legacy "no allowlist = allow everyone" branch
  4114	    let any guild member click the buttons -- approving exec commands,
  4115	    cancelling slash confirmations, switching the model.
  4116	
  4117	    Behavior:
  4118	
  4119	      - both allowlists empty -> allow (preserves existing no-allowlist
  4120	        deployments, no regression)
  4121	      - user is in user allowlist -> allow
  4122	      - role allowlist set + user has a role in it -> allow
  4123	      - role allowlist set + interaction.user has no resolvable
  4124	        ``roles`` attribute (e.g. DM context with a role policy active)
  4125	        -> reject (fail closed)
  4126	      - otherwise -> reject
  4127	    """
  4128	    user_set = allowed_user_ids or set()
  4129	    role_set = allowed_role_ids or set()
  4130	    has_users = bool(user_set)
  4131	    has_roles = bool(role_set)
  4132	    if not has_users and not has_roles:
  4133	        return True
  4134	
  4135	    user = getattr(interaction, "user", None)
  4136	    if user is None:
  4137	        return False
  4138	
  4139	    if has_users:
  4140	        try:
  4141	            uid = str(user.id)
  4142	        except AttributeError:
  4143	            uid = ""
  4144	        if uid and uid in user_set:
  4145	            return True

