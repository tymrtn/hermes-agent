   183	@dataclass
   184	class HomeChannel:
   185	    """
   186	    Default destination for a platform.
   187	    
   188	    When a cron job specifies deliver="telegram" without a specific chat ID,
   189	    messages are sent to this home channel.
   190	    """
   191	    platform: Platform
   192	    chat_id: str
   193	    name: str  # Human-readable name for display
   194	    
   195	    def to_dict(self) -> Dict[str, Any]:
   196	        return {
   197	            "platform": self.platform.value,
   198	            "chat_id": self.chat_id,
   199	            "name": self.name,
   200	        }

