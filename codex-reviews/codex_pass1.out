  2528	        def _maybe_update_status(force: bool = False) -> None:
  2529	            nonlocal last_active_count, last_status_at
  2530	            now = asyncio.get_running_loop().time()
  2531	            active_count = self._running_agent_count()
  2532	            if force or active_count != last_active_count or (now - last_status_at) >= 1.0:
