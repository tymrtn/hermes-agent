  4840	    async def send_or_update_busy_control_bubble(
  4841	        self,
  4842	        session_key: str,
  4843	        source: Any,
  4844	        summary_text: str,
  4845	    ) -> Optional[str]:
  4846	        if not self._busy_buttons_enabled() or not self._client:
  4847	            return None
  4848	        chat_id_raw = getattr(source, "chat_id", None) if source else None
  4849	        if not chat_id_raw:
  4850	            return None
  4851	        try:
  4852	            channel = self._client.get_channel(int(chat_id_raw))
  4853	            if not channel:
  4854	                channel = await self._client.fetch_channel(int(chat_id_raw))
  4855	        except Exception as exc:
