  2059	    def _queue_or_replace_pending_event(self, session_key: str, event: MessageEvent) -> None:
  2060	        adapter = self.adapters.get(event.source.platform)
  2061	        if not adapter:
  2062	            return
  2063	        merge_pending_message_event(adapter._pending_messages, session_key, event)
