   644	
   645	def _build_media_placeholder(event) -> str:
   646	    """Build a text placeholder for media-only events so they aren't dropped.
   647	
   648	    When a photo/document is queued during active processing and later
   649	    dequeued, only .text is extracted.  If the event has no caption,
   650	    the media would be silently lost.  This builds a placeholder that
   651	    the vision enrichment pipeline will replace with a real description.
   652	    """
   653	    parts = []
   654	    media_urls = getattr(event, "media_urls", None) or []
   655	    media_types = getattr(event, "media_types", None) or []
   656	    for i, url in enumerate(media_urls):
   657	        mtype = media_types[i] if i < len(media_types) else ""
   658	        if mtype.startswith("image/") or getattr(event, "message_type", None) == MessageType.PHOTO:
   659	            parts.append(f"[User sent an image: {url}]")
   660	        elif mtype.startswith("audio/"):
   661	            parts.append(f"[User sent audio: {url}]")
   662	        else:
   663	            parts.append(f"[User sent a file: {url}]")
   664	    return "\n".join(parts)
   665	
   666	
   667	def _dequeue_pending_event(adapter, session_key: str) -> MessageEvent | None:
   668	    """Consume and return the full pending event for a session.
   669	
   670	    Queued follow-ups must preserve their media metadata so they can re-enter
   671	    the normal image/STT/document preprocessing path instead of being reduced
   672	    to a placeholder string.
   673	    """
   674	    return adapter.get_pending_message(session_key)
